#!/usr/bin/env python3
"""Boot the real Nafinity application with, and then without, both example extensions.

The extensions are installed as ordinary Composer packages from local path
repositories into throwaway hosts that share Nafinity's own source. The
development installation is never touched and nothing here reaches a package
registry: this proves discovery, boot and uninstall, not distribution.

The second phase runs against the database the first phase left behind, which is
the whole point of it: what people stored has to survive the package going away.
"""
from pathlib import Path
import json
import shutil
import subprocess
import sys

root = Path(__file__).resolve().parents[1]
manifest = json.loads((root / "app/composer.json").read_text())
examples = ["example/nafinity-extension-a", "example/nafinity-extension-b"]


def build_host(folder, packages, order=None):
    """Write a disposable host that shares Nafinity's source and installs packages."""
    host = root / "work" / folder
    config = {
        "name": "local/nafinity-" + folder,
        "description": "Disposable host for the Nafinity extension checks",
        "type": "project",
        "license": "proprietary",
        "require": dict(manifest["require"]),
        "autoload": manifest["autoload"],
        "config": {"allow-plugins": False},
        "minimum-stability": "dev",
        "prefer-stable": True,
        "repositories": [],
    }
    for package, constraint in manifest["require"].items():
        if not package.startswith("naf/"):
            continue
        name = package.split("/")[1]
        config["repositories"].append(
            {
                "type": "path",
                "url": "../../packages/" + name,
                "options": {
                    "symlink": True,
                    "versions": {package: constraint.lstrip("^") + "-dev"},
                },
            }
        )
    for package in packages:
        folder_name = package.split("/")[1]
        config["repositories"].append(
            {
                "type": "path",
                "url": "../../examples/" + folder_name,
                "options": {"symlink": True, "versions": {package: "1.0.0"}},
            }
        )
        config["require"][package] = "*"

    host.mkdir(parents=True, exist_ok=True)
    (host / "composer.json").write_text(json.dumps(config, indent=2) + "\n")
    (host / "storage").mkdir(exist_ok=True)
    (host / "logs").mkdir(exist_ok=True)
    # The application's own source is copied rather than linked. A symlink would
    # be cheaper, but PHP resolves __DIR__ through one — a linked bootstrap.php
    # would define BASE_PATH as the development installation and load its vendor
    # — and a host of real files can also be packaged into an image later.
    for name in ["app", "tests", "public"]:
        target = host / name
        if target.is_symlink():
            target.unlink()
        elif target.is_dir():
            shutil.rmtree(target)
        shutil.copytree(root / "app" / name, target)
    (host / "bootstrap.php").write_text((root / "app/bootstrap.php").read_text())

    return host


def run(host, steps):
    completed = subprocess.run(
        [
            "docker",
            "compose",
            "--profile",
            "test",
            "run",
            "--rm",
            "-T",
            # The project is mounted where its own relative paths already point,
            # so a host directory looks the same from inside the container and
            # from this machine. An absolute container path in a repository would
            # leave a vendor directory only the container could read, and the
            # candidate build could never package it.
            "--volume",
            str(root) + ":/workspace/project",
            "--volume",
            str((root / "packages").resolve()) + ":/workspace/nafphp:ro",
            "--workdir",
            "/workspace/project/" + host.relative_to(root).as_posix(),
            "--env",
            "COMPOSER=composer.json",
            "--env",
            "NAFINITY_BOOTSTRAP=/workspace/project/"
            + host.relative_to(root).as_posix()
            + "/bootstrap.php",
            "app-test",
            "sh",
            "-c",
            "set -e\n" + "\n".join(steps),
        ],
        cwd=root,
        capture_output=True,
        text=True,
    )
    output = completed.stdout.strip()
    # A probe that reports failures still reports them as JSON; only a run that
    # produced no result at all is a reason to stop, because then the later
    # phases — including the cleanup — have nothing to work with.
    if "{" not in output:
        sys.stderr.write(output + "\n" + completed.stderr)
        for log in ["install.log", "migrate.log"]:
            file = host / log
            if file.is_file():
                sys.stderr.write("\n--- " + log + " ---\n" + file.read_text()[-2000:])
        sys.exit(completed.returncode or 1)

    return json.loads(output[output.index("{") :])


installed = build_host("extension-host", examples)
with_extensions = run(
    installed,
    [
        "composer install --no-interaction --no-progress > install.log 2>&1",
        "php vendor/bin/naf db:migrate up > migrate.log 2>&1",
        "php tests/extensions.php",
    ],
)

# The same host over real HTTP, with the fixtures the probe just created.
over_http = run(
    installed,
    [
        # The built-in server is stopped again, so the container run can end.
        "php -S 127.0.0.1:8099 -t public public/index.php > server.log 2>&1 &",
        "server=$!",
        "sleep 1",
        "set +e",
        "php tests/extensions_http.php",
        "status=$?",
        "kill $server 2>/dev/null",
        "exit $status",
    ],
)

# Publishing a package's public files, through the same class the CLI commands
# use, and then the commands themselves so their wiring is proven too.
assets = run(
    installed,
    [
        "php tests/extensions_assets.php",
    ],
)
run(
    installed,
    [
        "php vendor/bin/naf nafinity:assets:publish > assets-publish.log 2>&1",
        "php vendor/bin/naf nafinity:assets:check > assets-check.log 2>&1",
        "php vendor/bin/naf nafinity:assets:remove > assets-remove.log 2>&1",
        "echo '{}'",
    ],
)

# The same database, now without the packages: nothing is migrated down, because
# uninstalling a package does not delete what people stored with it.
removed = build_host("extension-host-without", [])
without_extensions = run(
    removed,
    [
        "composer install --no-interaction --no-progress > install.log 2>&1",
        "php tests/extensions_without.php",
    ],
)

# The disposable database now records a migration whose source only exists while
# the package is installed, so the schema is rolled back here rather than left
# for the next suite to trip over.
run(installed, ["php vendor/bin/naf db:migrate down > migrate-down.log 2>&1", "echo '{}'"])

evidence = {
    "with_extensions": with_extensions,
    "over_http": over_http,
    "assets": assets,
    "without_extensions": without_extensions,
    "passed": with_extensions["passed"]
    + over_http["passed"]
    + assets["passed"]
    + without_extensions["passed"],
    "failed": with_extensions["failed"]
    + over_http["failed"]
    + assets["failed"]
    + without_extensions["failed"],
}
print(json.dumps(evidence, indent=2, ensure_ascii=False))
(root / "docs/Plugin-Erweiterbarkeit-Evidenz.json").write_text(
    json.dumps(evidence, indent=2, ensure_ascii=False) + "\n"
)
sys.exit(1 if evidence["failed"] else 0)
