#!/usr/bin/env python3
"""Repeatable source-mode discovery/boot lab, isolated from Nafinity's product schema."""
from pathlib import Path
import json, subprocess

root=Path(__file__).resolve().parents[1]
lab=root/'work/plugin-lab'
requirements=json.loads((root/'app/composer.json').read_text())['require']
stacks={
    'minimal':['framework','cli','auth','database','form','orm','session','view'],
    'all':['framework','cli','auth','client','database','form','i18n','mail','mcp','oauth-client','oauth-server','orm','queue','schedule','session','view'],
}
probe=r'''<?php
declare(strict_types=1);
$_ENV['APP_ENV']='test';
define('BASE_PATH',__DIR__);
require __DIR__.'/vendor/autoload.php';
$app=Naf\app();$out=[];
foreach($app->getPlugins() as $name=>$plugin)$out['plugins'][$name]=['booted'=>$plugin->isBooted(),'path'=>$plugin->getBootstrapFile()];
$out['commands']=array_keys($app->container()->get(Naf\CLI\Support\CommandRegistry::class)->all());
$out['migrations']=Naf\Database\Support\MigrationRegistry::getPaths();
$out['pdo_bound']=$app->container()->has(PDO::class);
$out['pdo_driver']=$app->container()->get(PDO::class)->getAttribute(PDO::ATTR_DRIVER_NAME);
$out['routes']=array_keys(Naf\route()->all());
echo json_encode($out,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES)."\n";
'''
for mode,names in stacks.items():
    folder=lab/mode
    (folder/'app').mkdir(parents=True,exist_ok=True)
    config={'name':'local/nafinity-'+mode+'-lab','type':'project','license':'proprietary','description':'Unreleased source-mode NAF integration lab','require':{'php':'>=8.3'},'repositories':[],'minimum-stability':'dev','prefer-stable':True,'config':{'allow-plugins':False}}
    for name in names:
        package='naf/'+name
        version=requirements.get(package,'^0.2.2').lstrip('^')+'-dev'
        config['require'][package]=version
        config['repositories'].append({'type':'path','url':'/workspace/packages/'+name,'options':{'symlink':True,'versions':{package:version}}})
    (folder/'composer.json').write_text(json.dumps(config,indent=2)+'\n')
    (folder/'app/config.php').write_text("<?php return ['database'=>['driver'=>'sqlite','database'=>':memory:'],'public_url'=>'https://nafinity.example.test','language'=>'de'];\n")
    (folder/'probe.php').write_text(probe)
subprocess.run(['docker','compose','run','--rm','--no-deps','-v',str(lab)+':/workspace/labs','app','sh','-c','set -e; for mode in minimal all; do cd /workspace/labs/$mode; composer install --no-interaction --no-progress > install.log 2>&1; php probe.php > result.json; done'],cwd=root,check=True)
for mode,names in stacks.items():
    result=json.loads((lab/mode/'result.json').read_text())
    assert len(result['plugins'])==len(names)-1
    assert all(p['booted'] for p in result['plugins'].values())
    assert result['pdo_driver']=='sqlite'
    (root/'docs'/('Integration-'+mode+'.json')).write_text(json.dumps(result,indent=2)+'\n')
    print(mode+': '+str(len(result['plugins']))+' plugins booted; PDO='+result['pdo_driver'])
