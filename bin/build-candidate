#!/usr/bin/env python3
# Build an immutable local RC snapshot; this is explicitly not a published distribution.
from pathlib import Path
import argparse
import shutil
import subprocess
import json
import hashlib

root = Path(__file__).resolve().parents[1]
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument(
    "--source",
    default="app",
    help="Installation to package, relative to the project root (default: app).",
)
parser.add_argument("--tag", default="nafinity:candidate", help="Image tag to build.")
parser.add_argument(
    "--context",
    default="work/runtime-candidate",
    help="Build context directory, relative to the project root.",
)
arguments = parser.parse_args()
source = root / arguments.source
assert source.is_dir(), "No such installation: " + str(source)

# Registered plugin assets are published into the document root before anything
# is copied, so the image carries them as ordinary files. An installation with
# no plugins publishes nothing and the step is simply a no-op.
# The project is mounted where its own relative paths point, so an installation
# whose vendor directory links to ../../packages works here exactly as it does
# outside the container.
publish = subprocess.run(
    [
        "docker",
        "compose",
        "run",
        "--rm",
        "--no-deps",
        "-T",
        "--volume",
        str(root) + ":/workspace/project",
        "--volume",
        str((root / "packages").resolve()) + ":/workspace/nafphp:ro",
        "--workdir",
        "/workspace/project/" + source.relative_to(root).as_posix(),
        "app",
        "php",
        "vendor/bin/naf",
        "nafinity:assets:publish",
    ],
    cwd=root,
    capture_output=True,
    text=True,
    check=True,
)
# A CLI that cannot find its own entry point still exits zero, so the report it
# is supposed to print is what proves the step actually ran.
assert "Published" in publish.stdout, (
    "Publishing plugin assets produced no report:\n" + publish.stdout + publish.stderr
)
print(publish.stdout.strip())

context = root / arguments.context
context.mkdir(parents=True, exist_ok=True)
app = context / "app"
if app.exists():
    shutil.rmtree(app)
ignore = shutil.ignore_patterns(
    ".git",
    ".idea",
    ".env*",
    "identity.local.php",
    "*-ca.pem",
    "vendor",
    "storage",
    "logs",
    "tests",
    "__pycache__",
    ".phpstan-cache",
    ".phpunit.cache",
    ".phpunit.result.cache",
    ".php-cs-fixer.cache",
    ".DS_Store",
    "composer.dev.*",
    "composer.lock",
)
shutil.copytree(source, app, ignore=ignore)
# Package names must not be filtered by application data-directory names.
vendor_ignore = shutil.ignore_patterns(
    ".git",
    ".idea",
    ".env*",
    "identity.local.php",
    "*-ca.pem",
    "vendor",
    "logs",
    "tests",
    "__pycache__",
    ".phpstan-cache",
    ".phpunit.cache",
    ".phpunit.result.cache",
    ".php-cs-fixer.cache",
    ".DS_Store",
    "composer.dev.*",
    "composer.lock",
)
shutil.copytree(source / "vendor", app / "vendor", symlinks=False, ignore=vendor_ignore)
docker_context = context / "docker"
if docker_context.exists():
    shutil.rmtree(docker_context)
shutil.copytree(
    root / "docker", docker_context, ignore=shutil.ignore_patterns("*.pem", ".generate-*")
)
packages = {}
for manifest in (app / "vendor/naf").glob("*/composer.json"):
    package = manifest.parent
    files = sorted(p for p in package.rglob("*") if p.is_file())
    digest = hashlib.sha256()
    for file in files:
        digest.update(str(file.relative_to(package)).encode())
        digest.update(file.read_bytes())
    packages[json.loads(manifest.read_text())["name"]] = digest.hexdigest()
published = sorted(
    str(asset.relative_to(app / "public"))
    for asset in (app / "public/plugins").rglob("*")
    if asset.is_file()
)
(app / "source-snapshot.json").write_text(
    json.dumps(
        {
            "mode": "unreleased-source-snapshot",
            "source": arguments.source,
            "packages": packages,
            "published_plugin_assets": published,
        },
        indent=2,
    )
    + "\n"
)
expected = {
    name
    for name in json.loads((source / "composer.json").read_text())["require"]
    if name.startswith("naf/")
}
assert expected == set(packages), "The snapshot is missing required NAF packages: " + str(
    expected - set(packages)
)
assert not any(p.is_symlink() for p in app.rglob("*"))
base = (root / "docker/Dockerfile").read_text().split("# Vendor must be prepared")[0]
(context / "Dockerfile").write_text(
    base
    + """FROM runtime AS candidate
LABEL org.opencontainers.image.title="Nafinity local RC snapshot"
LABEL dev.nafinity.distribution="unreleased-source-snapshot"
COPY --chown=www:www app/ /workspace/app/
RUN mkdir -p storage/sessions storage/logs storage/attachments storage/queue storage/schedule storage/oauth
"""
)
subprocess.run(
    ["docker", "build", "--target", "candidate", "-t", arguments.tag, str(context)],
    check=True,
)
print(
    "Built "
    + arguments.tag
    + " without source mounts, symlinks or Composer, carrying "
    + str(len(published))
    + " published plugin asset(s). Package releases remain a separate gate."
)
