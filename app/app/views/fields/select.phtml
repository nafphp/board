<?php

use function Naf\I18n\t;
use function Nafinity\partial;

$choices = $definition->options['choices'] ?? [];
$options = [];
if (($definition->options['nullable'] ?? false) === true) {
    $options[''] = t('Nicht gesetzt');
}
foreach ($choices as $key => $label) {
    $options[(string) $key] = t((string) $label);
}
?>
<?= partial('components/choice', [
    'name'     => $name,
    'label'    => $definition->label ?: $name,
    'value'    => $value === null ? '' : (string) $value,
    'options'  => $options,
    'id'       => $id,
    'disabled' => $disabled,
]) ?>
