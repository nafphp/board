<?php

use App\Support\Locales;

use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;

?>
<form
    class="language-picker"
    method="post"
    action="<?= s(route('preferences.language')) ?>"
    data-language-picker
>
    <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
    <label class="sr-only" for="locale-picker"><?= s(t('Sprache wählen')) ?></label>
    <span class="language-flag" aria-hidden="true"><?= Locales::flag($preferences['locale']) ?></span>
    <select id="locale-picker" name="locale">
        <?php foreach (Locales::available() as $code => $name): ?>
            <option value="<?= s($code) ?>" <?= $preferences['locale'] === $code ? 'selected' : '' ?>><?= Locales::flag($code) ?> <?= s($name) ?></option>
        <?php endforeach ?>
    </select>
    <span class="language-name" aria-hidden="true"><?= s(Locales::name($preferences['locale'])) ?></span>
    <noscript><button class="button subtle"><?= s(t('Wechseln')) ?></button></noscript>
</form>
