<?php

use App\Support\Format;

use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;
use function Nafinity\slot;
use function Nafinity\template;

$this->setLayout(template('layout'));
$this->block('content');
$openTickets = array_sum(array_column($projects, 'open_count'));
$archived    = count(array_filter($projects, static fn($item) => $item['archived_at'] !== null));
?>
<section class="page-heading">
    <div>
        <span class="eyebrow"><?= s(t('PROJEKTÜBERSICHT')) ?></span>
        <h1><?= s(t('Deine Projekte')) ?></h1>
        <?php if ($projects): ?>
            <p>
                <?= s(Format::count(count($projects), 'Projekt', 'Projekte')) ?>
                · <?= s(Format::count($openTickets, 'offenes Ticket', 'offene Tickets')) ?><?= $archived ? ' · ' . s(t(':count archiviert', ['count' => $archived])) : '' ?>
            </p>
        <?php endif ?>
    </div>
    <?= slot('projects.actions', $uiContext) ?>
    <button class="button primary" data-dialog="new-project">+ Neues Projekt</button>
</section>
<div class="project-cards">
    <?php foreach ($projects as $projectItem): ?>
        <a class="project-overview-card" href="<?= s(route('board', ['project' => $projectItem['id']])) ?>">
            <span class="project-symbol large" style="--project-color: <?= s($projectItem['color']) ?>">
                <?= s($projectItem['icon']) ?>
            </span>
            <h2><?= s($projectItem['name']) ?></h2>
            <p><?= s($projectItem['description']) ?></p>
            <span><?= (int) $projectItem['open_count'] ?> offene Tickets · <?= s($projectItem['role']) ?><?= $projectItem['archived_at'] ? ' · Archiviert' : '' ?></span>
            <?= slot('projects.card.badges', $uiContext, ['project' => $projectItem]) ?>
        </a>
    <?php endforeach ?>
    <?php if (!$projects): ?>
        <div class="empty-state">
            <span>◌</span>
            <h2><?= s(t('Noch keine Projekte')) ?></h2>
            <p><?= s(t('Erstelle ein Projekt oder lass dich zu einem bestehenden Projekt hinzufügen.')) ?></p>
            <button class="button primary" data-dialog="new-project"><?= s(t('Projekt erstellen')) ?></button>
        </div>
    <?php endif ?>
</div>
<?php $this->endblock('content'); ?>
