<?php

use App\Domain\Estimation;
use App\Support\Duration;

use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;
use function Nafinity\partial;

/**
 * The planning group: estimate, dates and the time actually counted.
 *
 * Contributed fields of this group are rendered after the ones Nafinity brings,
 * in the order the registry gives them.
 */
?>
<section class="ticket-sidebar-group">
    <h2><?= s(t('Planung & Zeit')) ?></h2>
    <dl class="ticket-meta">
        <?php if ($estimating): ?><dt><?= s(t(Estimation::label($scale))) ?></dt><dd><?= $slot->field->render('estimate_points', Estimation::label($scale), 'select', $points, $pointDisplay, $pointOptions) ?></dd><?php endif ?>
        <dt><?= s(t('Startdatum')) ?></dt><dd><?= $slot->field->render('start_date', 'Startdatum', 'date', $slot->ticket['start_date'], $slot->ticket['start_date'] ? s(date('d.m.Y', strtotime($slot->ticket['start_date']))) : $empty) ?></dd>
        <dt><?= s(t('Fällig am')) ?></dt><dd><?= $slot->field->render('due_date', 'Fällig am', 'date', $slot->ticket['due_date'], $slot->ticket['due_date'] ? s(date('d.m.Y', strtotime($slot->ticket['due_date']))) : $empty) ?></dd>
        <dt><?= s(t('Geschätzt')) ?></dt><dd><?= $slot->field->render('estimate_minutes', 'Geschätzt', 'duration', $slot->ticket['estimate_minutes'] === null ? '' : Duration::format((int) $slot->ticket['estimate_minutes']), s($duration($slot->ticket['estimate_minutes'] === null ? null : (int) $slot->ticket['estimate_minutes']))) ?></dd>
        <dt><?= s(t('Erfasst')) ?></dt>
        <dd class="ticket-spent">
            <?= $slot->field->render('spent_minutes', 'Erfasst', 'duration', Duration::format((int) $slot->ticket['spent_minutes']), s($duration((int) $slot->ticket['spent_minutes']))) ?>
            <?php if (!$slot->isNew && $slot->editable): ?>
            <?php $timerState = $slot->timer['state'] ?? 'stopped'; ?>
                <div
                    class="ticket-timer"
                    data-ticket-timer
                    data-action="<?= s(route('ticket.timer', $slot->params)) ?>"
                    data-token="<?= s($slot->token) ?>"
                    data-state="<?= s($timerState) ?>"
                    data-seconds="<?= (int) ($slot->timer['seconds'] ?? 0) ?>"
                    data-label-start="<?= s(t('Zeiterfassung starten')) ?>"
                    data-label-resume="<?= s(t('Zeiterfassung fortsetzen')) ?>"
                    data-label-pause="<?= s(t('Zeiterfassung pausieren')) ?>"
                >
                    <button
                        type="button"
                        class="timer-button"
                        data-timer-toggle
                        aria-describedby="timer-hold-hint"
                        title="<?= s(t('Gedrückt halten beendet die Erfassung')) ?>"
                    >
                        <svg class="timer-ring" viewBox="0 0 36 36" aria-hidden="true" preserveAspectRatio="none">
                            <rect class="timer-track" x="1.3" y="1.3" width="33.4" height="33.4" rx="9.7" />
                            <rect class="timer-hold" x="1.3" y="1.3" width="33.4" height="33.4" rx="9.7" />
                        </svg>
                        <span class="timer-face">
                            <span class="timer-glyph" aria-hidden="true">
                                <svg viewBox="0 0 14 14">
                                    <path class="glyph-play" d="M4.6 2.7 11.2 7 4.6 11.3Z" />
                                    <path class="glyph-pause" d="M4.9 3.2v7.6M9.1 3.2v7.6" />
                                </svg>
                            </span>
                            <time class="timer-readout" data-timer-readout><?= s(sprintf('%d:%02d', intdiv((int) ($slot->timer['seconds'] ?? 0), 60), (int) ($slot->timer['seconds'] ?? 0) % 60)) ?></time>
                        </span>
                    </button>
                    <span id="timer-hold-hint" class="sr-only">
                        <?= s(t('Gedrückt halten beendet die Erfassung. Sie läuft auf dem Server weiter, auch wenn du den Tab schließt. Beim Pausieren und Beenden werden die vollen Minuten unter Erfasst gebucht.')) ?>
                    </span>
                    <div class="form-errors" role="alert"></div>
                </div>
            <?php endif ?>
        </dd>
    <?php foreach ($slot->fieldsIn('planning') as $metaKey => $metaField): ?>
        <?= partial('ticket/metadata', [
            'definition' => $metaField,
            'value'      => $slot->value($metaKey),
            'field'      => $slot->field,
            'editable'   => $slot->editable,
        ]) ?>
    <?php endforeach ?>
    </dl>
    <div data-ticket-readonly="progress" class="ticket-time-progress">
        <?php if ((int) $slot->ticket['estimate_minutes'] > 0): ?><progress value="<?= min((int) $slot->ticket['spent_minutes'], (int) $slot->ticket['estimate_minutes']) ?>" max="<?= (int) $slot->ticket['estimate_minutes'] ?>" aria-label="<?= s(t('Erfasster Zeitaufwand')) ?>"></progress><span class="muted small"><?= s($duration(abs((int) $slot->ticket['estimate_minutes'] - (int) $slot->ticket['spent_minutes']))) ?> <?= s(t((int) $slot->ticket['spent_minutes'] > (int) $slot->ticket['estimate_minutes'] ? 'über Schätzung' : 'verbleibend')) ?></span><?php endif ?>
    </div>
</section>
