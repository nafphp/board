<?php
use App\Support\Icon;

use function Naf\I18n\t;
use function Naf\View\s;

?>
<div class="ticket-choice" data-ticket-choice="<?= s($name) ?>" data-choice-label="<?= s(t($label)) ?>" data-choice-empty="<?= s(t('Nicht zugewiesen')) ?>">
    <div data-choice-native>
    <?php if ($type === 'multiple'): ?>
        <input type="hidden" name="<?= s($name) ?>" value="" />
        <div class="ticket-options" role="group" aria-label="<?= s(t($label)) ?>">
            <?php foreach ($options as $key => $text): ?>
                <label><input type="checkbox" name="<?= s($name) ?>[]" value="<?= s($key) ?>" <?= in_array($key, $value) ? 'checked' : '' ?> /> <?= s($text) ?></label>
            <?php endforeach ?>
        </div>
    <?php else: ?>
    <select id="edit-<?= s($name) ?>" name="<?= s($name) ?>">
        <?php foreach ($options as $key => $text): ?>
            <option value="<?= s($key) ?>" <?= (string) $value === (string) $key ? 'selected' : '' ?>><?= s($text) ?></option>
        <?php endforeach ?>
    </select>
    <?php endif ?>
    </div>
    <button type="button" class="choice-trigger" data-choice-trigger aria-label="<?= s(t($label)) ?>" aria-haspopup="listbox" aria-expanded="false" aria-controls="choice-list-<?= s($name) ?>" hidden>
        <span data-choice-value></span><span class="choice-chevron" aria-hidden="true"><?= Icon::mark('expand_more', 'sm') ?></span>
    </button>
    <div class="choice-popup" data-choice-popup popover="manual" hidden>
        <div class="choice-search-wrap">
            <span aria-hidden="true"><?= Icon::mark('search', 'sm') ?></span>
            <input type="search" data-choice-search role="combobox" aria-label="<?= s(t($name === 'column_id' ? 'Spalten suchen' : 'Personen suchen')) ?>" placeholder="<?= s(t($name === 'column_id' ? 'Spalten suchen …' : 'Personen suchen …')) ?>" autocomplete="off" aria-autocomplete="list" aria-expanded="false" aria-controls="choice-list-<?= s($name) ?>" />
        </div>
        <div class="choice-list" id="choice-list-<?= s($name) ?>" role="listbox" <?= $type === 'multiple' ? 'aria-multiselectable="true"' : '' ?> aria-label="<?= s(t($label)) ?>"></div>
        <p class="choice-empty" role="status" hidden><?= s(t('Keine Treffer')) ?></p>
    </div>
</div>
