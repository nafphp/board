<?php
use function Naf\I18n\t;
use function Naf\View\s;
use function Nafinity\choice;

$creating ??= false;
?>
<div class="ticket-field <?= s($class ?? '') ?>" data-inline-field="<?= s($name) ?>">
    <?php if (!$creating): ?>
    <div class="inline-display <?= $type === 'rich' ? 'ticket-prose' : '' ?>" <?= $editable ? 'role="button" tabindex="0" aria-expanded="false"' : '' ?> aria-label="<?= s(t($label)) ?><?= $editable ? ': ' . s(t('Bearbeiten')) : '' ?>">
        <?= $display ?>
    </div>
    <?php endif ?>
    <?php if ($editable): ?>
        <?php if (!$creating): ?>
        <form method="post" action="<?= s($action) ?>" data-ticket-form data-auto-save="<?= s(t('Änderungen werden automatisch gespeichert')) ?>" hidden>
            <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
            <input type="hidden" name="version" value="<?= (int) $ticket['version'] ?>" />
            <input type="hidden" name="board_revision" value="<?= (int) $board['revision'] ?>" />
            <?php foreach ($hidden ?? [] as $key => $item): ?>
                <input type="hidden" name="<?= s($key) ?>" value="<?= s($item) ?>" />
            <?php endforeach ?>
        <?php endif ?>
            <label class="sr-only" for="edit-<?= s($name) ?>"><?= s(t($label)) ?></label>
            <?php if ($type === 'select' || in_array($name, ['column_id', 'assignee_ids'], true)): ?>
                <?= choice([
                    'name'        => $name,
                    'label'       => $label,
                    'value'       => $value,
                    'options'     => $options,
                    'multiple'    => $type === 'multiple',
                    'avatars'     => $name === 'assignee_ids',
                    'searchLabel' => match ($name) {
                        'column_id'    => 'Spalten suchen',
                        'assignee_ids' => 'Personen suchen',
                        default        => 'Einträge suchen',
                    },
                    // Column and people are searched however short the list is:
                    // that is how both already behaved before this was reusable.
                    'searchFrom' => in_array($name, ['column_id', 'assignee_ids'], true) ? 0 : 8,
                ]) ?>
            <?php elseif ($type === 'multiple'): ?>
                <input type="hidden" name="<?= s($name) ?>" value="" />
                <div class="ticket-options" role="group" aria-label="<?= s(t($label)) ?>">
                    <?php foreach ($options as $key => $text): ?>
                        <label><input type="checkbox" name="<?= s($name) ?>[]" value="<?= s($key) ?>" <?= in_array($key, $value) ? 'checked' : '' ?> /> <?= s($text) ?></label>
                    <?php endforeach ?>
                    <?php if (!$options): ?><span class="muted"><?= s(t('Keine Einträge vorhanden.')) ?></span><?php endif ?>
                </div>
            <?php elseif ($type === 'rich'): ?>
                <div data-rich-editor></div>
                <textarea id="edit-<?= s($name) ?>" name="<?= $creating ? 'description' : 'description_html' ?>" <?= $creating ? 'rows="8" maxlength="50000"' : 'hidden' ?>><?= s($value) ?></textarea>
            <?php elseif ($type === 'text'): ?>
                <textarea id="edit-<?= s($name) ?>" name="<?= s($name) ?>" rows="1" required maxlength="200" <?= $creating ? 'placeholder="' . s(t('Was soll erledigt werden?')) . '"' : '' ?>><?= s($value) ?></textarea>
            <?php elseif ($type === 'line'): ?>
                <input
                    id="edit-<?= s($name) ?>"
                    type="text"
                    name="<?= s($name) ?>"
                    value="<?= s((string) ($value ?? '')) ?>"
                    <?= isset($maxlength) ? 'maxlength="' . (int) $maxlength . '"' : '' ?>
                    <?= ($required ?? false) ? 'required' : '' ?>
                />
            <?php elseif ($type === 'longtext'): ?>
                <textarea
                    id="edit-<?= s($name) ?>"
                    name="<?= s($name) ?>"
                    rows="3"
                    <?= isset($maxlength) ? 'maxlength="' . (int) $maxlength . '"' : '' ?>
                    <?= ($required ?? false) ? 'required' : '' ?>
                ><?= s((string) ($value ?? '')) ?></textarea>
            <?php elseif ($type === 'duration'): ?>
                <input
                    id="edit-<?= s($name) ?>"
                    type="text"
                    name="<?= s($name) ?>"
                    value="<?= s($value ?? '') ?>"
                    placeholder="2h 40m"
                    autocomplete="off"
                    spellcheck="false"
                />
                <span class="muted small"><?= s(t('z. B. 2h 40m oder 1:30')) ?></span>
            <?php else: ?>
                <input id="edit-<?= s($name) ?>" type="<?= s($type) ?>" name="<?= s($name) ?>" value="<?= s($value ?? '') ?>" <?= $type === 'number' ? 'min="0" max="10000000" step="1"' : '' ?> />
                <?php if ($type === 'number'): ?><span class="muted small"><?= s(t('Zeit in Minuten')) ?></span><?php endif ?>
            <?php endif ?>
        <?php if (!$creating): ?>
            <div class="form-errors" role="alert"></div>
        </form>
        <?php endif ?>
    <?php endif ?>
</div>
