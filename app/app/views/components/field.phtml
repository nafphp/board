<?php

/**
 * Labelled form field.
 *
 * One entry point for the ordinary controls: the label, the control itself and
 * an optional hint below it. `select` and `multiselect` hand over to
 * `components/choice.phtml`, so a select looks and behaves the same wherever it
 * appears. Nothing here introduces a new endpoint or a new name: the control is
 * the plain native element the form always posted.
 *
 * @var string      $label
 * @var string      $name
 * @var string      $type     text|email|url|password|number|color|date|search|textarea|checkbox|select|multiselect
 * @var mixed       $value
 * @var string|null $hint     small print under the control
 * @var array       $options  value => text, for select and multiselect
 * @var string      $id
 * @var string      $class    extra classes on the label
 * @var bool        $required
 * @var bool        $disabled
 * @var array       $attributes  further attributes on the control, name => value
 * @var array       $choice   further arguments handed to components/choice.phtml
 */

use function Naf\I18n\t;
use function Naf\View\s;
use function Nafinity\partial;

$type ??= 'text';
$value ??= '';
$hint ??= null;
$options ??= [];
$id ??= 'field-' . preg_replace('/[^A-Za-z0-9_-]/', '-', $name);
$class ??= '';
$required ??= false;
$disabled ??= false;
$attributes ??= [];
$choice ??= [];

$extra = '';
foreach ($attributes as $attribute => $content) {
    if ($content === false || $content === null) {
        continue;
    }
    $extra .= ' ' . s($attribute) . ($content === true ? '' : '="' . s((string) $content) . '"');
}
if ($required) {
    $extra .= ' required';
}
if ($disabled) {
    $extra .= ' disabled';
}
?>
<label<?= $class === '' ? '' : ' class="' . s($class) . '"' ?><?= $type === 'checkbox' ? '' : ' for="' . s($id) . '"' ?>>
    <?php if ($type === 'checkbox'): ?>
        <input type="checkbox" id="<?= s($id) ?>" name="<?= s($name) ?>" value="1" <?= $value ? 'checked' : '' ?><?= $extra ?> />
        <?= s(t($label)) ?>
    <?php else: ?>
        <?= s(t($label)) ?>
        <?php if ($type === 'select' || $type === 'multiselect'): ?>
            <?= partial('components/choice', $choice + [
                'name'     => $name,
                'label'    => $label,
                'value'    => $value,
                'options'  => $options,
                'multiple' => $type === 'multiselect',
                'id'       => $id,
                'required' => $required,
                'disabled' => $disabled,
            ]) ?>
        <?php elseif ($type === 'textarea'): ?>
            <textarea id="<?= s($id) ?>" name="<?= s($name) ?>"<?= $extra ?>><?= s((string) $value) ?></textarea>
        <?php else: ?>
            <input type="<?= s($type) ?>" id="<?= s($id) ?>" name="<?= s($name) ?>" value="<?= s((string) $value) ?>"<?= $extra ?> />
        <?php endif ?>
    <?php endif ?>
    <?php if ($hint !== null): ?>
        <small><?= s(t($hint)) ?></small>
    <?php endif ?>
</label>
