<?php

/**
 * Reusable select.
 *
 * The native control inside stays the source of the form value and the whole
 * fallback without JavaScript; `choice.js` only draws a searchable listbox over
 * it. Nothing here needs a new endpoint, and validation stays where it was.
 *
 * @var string      $name        form field name
 * @var string      $label       accessible label, passed through t()
 * @var array       $options     value => text
 * @var mixed       $value       current value, or a list of values when $multiple
 * @var bool        $multiple    several values, stored as checkboxes
 * @var string      $empty       shown when nothing is selected
 * @var string      $searchLabel accessible label of the search field
 * @var string|null $placeholder search placeholder, defaults to $searchLabel
 * @var bool        $avatars     draw an initial in front of every entry
 * @var int         $searchFrom  option count from which the search field appears
 * @var array       $optionData  value => ['name' => 'value'] rendered as data-* on the option
 * @var array       $nativeData  ['name' => 'value'] rendered as data-* on the native control
 * @var string      $id          id of the native control
 * @var string      $class       extra classes on the wrapper
 * @var bool        $required
 * @var bool        $disabled    leaves the native control in place, unenhanced
 */

use App\Support\Icon;

use function Naf\I18n\t;
use function Naf\View\s;

$multiple ??= ($type ?? '') === 'multiple';
$value ??= $multiple ? [] : '';
$options ??= [];
$empty ??= $multiple ? 'Nicht zugewiesen' : 'Nicht gewählt';
$searchLabel ??= 'Einträge suchen';
$placeholder ??= $searchLabel . ' …';
$avatars ??= false;
$searchFrom ??= 8;
$optionData ??= [];
$nativeData ??= [];

$native = '';
foreach ($nativeData as $attribute => $content) {
    $native .= ' data-' . s($attribute) . ($content === true ? '' : '="' . s((string) $content) . '"');
}
$id ??= 'edit-' . $name;
$class ??= '';
$required ??= false;
$disabled ??= false;

$listId   = 'choice-list-' . preg_replace('/[^A-Za-z0-9_-]/', '-', $name);
$selected = $multiple ? array_map('strval', (array) $value) : [];
?>
<div
    class="choice <?= s($class) ?>"
    <?= $disabled ? '' : 'data-choice="' . s($name) . '"' ?>
    data-choice-label="<?= s(t($label)) ?>"
    data-choice-empty="<?= s(t($empty)) ?>"
    data-choice-search="<?= (int) $searchFrom ?>"
    <?= $avatars ? 'data-choice-avatars' : '' ?>
>
    <div data-choice-native>
    <?php if ($multiple): ?>
        <input type="hidden" name="<?= s($name) ?>" value="" />
        <div class="ticket-options" role="group" aria-label="<?= s(t($label)) ?>">
            <?php foreach ($options as $key => $text): ?>
                <label><input type="checkbox" name="<?= s($name) ?>[]" value="<?= s($key) ?>" <?= in_array((string) $key, $selected, true) ? 'checked' : '' ?> /> <?= s($text) ?></label>
            <?php endforeach ?>
            <?php if (!$options): ?><span class="muted"><?= s(t('Keine Einträge vorhanden.')) ?></span><?php endif ?>
        </div>
    <?php else: ?>
        <select id="<?= s($id) ?>" name="<?= s($name) ?>"<?= $native ?> <?= $required ? 'required' : '' ?> <?= $disabled ? 'disabled' : '' ?>>
            <?php foreach ($options as $key => $text): ?>
                <?php $data = '';
                foreach ($optionData[$key] ?? [] as $attribute => $content) {
                    $data .= ' data-' . s($attribute) . '="' . s((string) $content) . '"';
                } ?>
                <option value="<?= s($key) ?>"<?= $data ?> <?= (string) $value === (string) $key ? 'selected' : '' ?>><?= s($text) ?></option>
            <?php endforeach ?>
        </select>
    <?php endif ?>
    </div>
    <button type="button" class="choice-trigger" data-choice-trigger aria-label="<?= s(t($label)) ?>" aria-haspopup="listbox" aria-expanded="false" aria-controls="<?= s($listId) ?>" hidden>
        <span data-choice-value></span><span class="choice-chevron" aria-hidden="true"><?= Icon::mark('expand_more', 'sm') ?></span>
    </button>
    <div class="choice-popup" data-choice-popup popover="manual" hidden>
        <div class="choice-search-wrap">
            <span aria-hidden="true"><?= Icon::mark('search', 'sm') ?></span>
            <input type="search" data-choice-search role="combobox" aria-label="<?= s(t($searchLabel)) ?>" placeholder="<?= s(t($placeholder)) ?>" autocomplete="off" aria-autocomplete="list" aria-expanded="false" aria-controls="<?= s($listId) ?>" />
        </div>
        <div class="choice-list" id="<?= s($listId) ?>" role="listbox" <?= $multiple ? 'aria-multiselectable="true"' : '' ?> aria-label="<?= s(t($label)) ?>"></div>
        <p class="choice-empty" role="status" hidden><?= s(t('Keine Treffer')) ?></p>
    </div>
</div>
