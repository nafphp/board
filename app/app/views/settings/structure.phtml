<?php
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;

?>
<?php foreach ($items as $item): ?>
    <form method="post" data-enhanced class="structure-row" action="<?= s(route('project.structure', ['project' => $projectId])) ?>">
        <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
        <input type="hidden" name="kind" value="<?= s($kind) ?>" />
        <input type="hidden" name="id" value="<?= (int) $item['id'] ?>" />
        <div class="form-grid">
            <label>
                <?= s(t('Name')) ?>
                <input name="name" required maxlength="60" value="<?= s($item['name']) ?>" />
            </label>
            <?php if ($kind !== 'swimlane'): ?>
                <label>
                    <?= s(t('Farbe')) ?>
                    <input type="color" name="color" value="<?= s($item['color']) ?>" />
                </label>
            <?php else: ?>
                <span class="muted small"><?= (int) $item['is_default'] === 1 ? 'Standard-Swimlane' : '' ?></span>
            <?php endif ?>
        </div>
        <?php if ($kind === 'column'): ?>
            <div class="form-grid">
                <label>
                    Ticketstatus beim Verschieben
                    <select name="closes_tickets">
                        <option value="0" <?= !(int) $item['closes_tickets'] ? 'selected' : '' ?>><?= s(t('Offen')) ?></option>
                        <option value="1" <?= (int) $item['closes_tickets'] ? 'selected' : '' ?>><?= s(t('Geschlossen')) ?></option>
                    </select>
                </label>
                <label>
                    WIP-Richtwert (optional)
                    <input type="number" name="wip_limit" min="1" value="<?= s((string) ($item['wip_limit'] ?? '')) ?>" />
                </label>
            </div>
        <?php endif ?>
        <div class="form-errors" role="alert"></div>
        <button class="button subtle"><?= s(t('Speichern')) ?></button>
        <?php if ($kind !== 'label'): ?>
            <button
                class="button subtle"
                name="direction"
                value="up"
                aria-label="<?= s($item['name']) ?> nach oben"
            >
                ↑
            </button>
            <button
                class="button subtle"
                name="direction"
                value="down"
                aria-label="<?= s($item['name']) ?> nach unten"
            >
                ↓
            </button>
        <?php endif ?>
        <?php if ($kind !== 'swimlane' || !(int) $item['is_default']): ?>
            <button class="button danger subtle" name="action" value="delete">Entfernen</button>
        <?php endif ?>
    </form>
<?php endforeach ?>
<details style="margin-top: 18px">
    <summary class="text-button">
        +
        <?= s($kind === 'column' ? t('Neue Spalte') : ($kind === 'swimlane' ? t('Neue Swimlane') : t('Neues Label'))) ?>
    </summary>
    <form method="post" data-enhanced action="<?= s(route('project.structure', ['project' => $projectId])) ?>">
        <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
        <input type="hidden" name="kind" value="<?= s($kind) ?>" />
        <label>
            <?= s(t('Name')) ?>
            <input name="name" required maxlength="60" />
        </label>
        <?php if ($kind !== 'swimlane'): ?>
            <label>
                <?= s(t('Farbe')) ?>
                <input type="color" name="color" value="#6366f1" />
            </label>
        <?php endif ?>
        <div class="form-errors" role="alert"></div>
        <button class="button primary"><?= s(t('Hinzufügen')) ?></button>
    </form>
</details>
