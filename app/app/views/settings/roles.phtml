<?php
use App\Domain\ProjectPermissions;
use App\Support\Format;

use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;
use function Nafinity\extensions;

?>
<div class="settings-note">
    Alle Rollen dürfen das Projekt lesen. Nur Owner verwalten eigene Rollen und andere Owner.
    Mindestens ein Owner bleibt immer erhalten.
</div>
<div class="role-defaults">
    <?php foreach (['owner', 'manager', 'member', 'viewer'] as $builtIn): ?>
        <details>
            <summary>
                <strong><?= s(ucfirst($builtIn)) ?></strong>
                <span class="badge">Standardrolle</span>
            </summary>
            <ul>
                <?php foreach (ProjectPermissions::LABELS as $permission => $label): ?>
                    <?php if (in_array($permission, ProjectPermissions::defaults($builtIn), true)): ?>
                        <li><?= s($label) ?></li>
                    <?php endif ?>
                <?php endforeach ?>
            </ul>
            <?php if ($builtIn === 'viewer'): ?>
                <p>Lesen, suchen und private Anhänge herunterladen.</p>
            <?php endif ?>
            <?php if ($builtIn === 'owner'): ?>
                <p>Zusätzlich Rollen und Owner verwalten, Projekt archivieren und wiederherstellen.</p>
            <?php endif ?>
        </details>
    <?php endforeach ?>
</div>
<h3>
    Eigene Rollen
    <span class="count"><?= count($customRoles) ?></span>
</h3>
<?php foreach ([...$customRoles, ...($scope->allows('roles') ? [null] : [])] as $role): ?>
    <details class="role-editor" <?= $role === null && !$customRoles ? 'open' : '' ?>>
        <summary><?= $role ? s($role['name']) . ' · ' . s(Format::count((int) $role['member_count'], 'Mitglied', 'Mitglieder')) : '+ Eigene Rolle anlegen' ?></summary>
        <form method="post" data-enhanced action="<?= s(route('project.roles', ['project' => $projectId])) ?>">
            <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
            <?php if ($role): ?>
                <input type="hidden" name="id" value="<?= (int) $role['id'] ?>" />
                <input type="hidden" name="version" value="<?= (int) $role['version'] ?>" />
            <?php endif ?>
            <fieldset <?= !$scope->allows('roles') ? 'disabled' : '' ?>>
                <label>
                    Rollenname
                    <input
                        name="name"
                        required
                        maxlength="60"
                        value="<?= s($role['name'] ?? '') ?>"
                        placeholder="Zum Beispiel: Redaktion"
                    />
                </label>
                <label>
                    Beschreibung
                    <input
                        name="description"
                        maxlength="255"
                        value="<?= s($role['description'] ?? '') ?>"
                        placeholder="Wofür ist diese Rolle zuständig?"
                    />
                </label>
                <div class="permission-grid">
                    <?php foreach (extensions()->permissions()->assignable() as $permission => $definition): ?>
                        <label title="<?= s(t($definition->description)) ?>">
                            <input
                                type="checkbox"
                                name="permissions[]"
                                value="<?= s($permission) ?>"
                                <?= in_array($permission, $role['permissions'] ?? [], true) ? 'checked' : '' ?>
                            />
                            <span><?= s(t($definition->label)) ?></span>
                        </label>
                    <?php endforeach ?>
                </div>
                <?php if ($role['unavailable'] ?? []): ?>
                    <p class="settings-hint">
                        <?= s(t(
                            'Diese Rolle hält :count Recht(e) einer Erweiterung, die gerade nicht '
                            . 'installiert ist. Sie bleiben gespeichert und wirken erst wieder, '
                            . 'wenn die Erweiterung zurück ist.',
                            ['count' => count($role['unavailable'])],
                        )) ?>
                    </p>
                <?php endif ?>
                <?php if ($scope->allows('roles')): ?>
                    <div class="form-errors" role="alert"></div>
                    <button class="button primary"><?= $role ? 'Rolle speichern' : 'Rolle anlegen' ?></button>
                    <?php if ($role): ?>
                        <button class="button subtle danger" name="action" value="delete" formnovalidate>
                            Rolle löschen
                        </button>
                    <?php endif ?>
                <?php endif ?>
            </fieldset>
        </form>
    </details>
<?php endforeach ?>
<?php if (!$customRoles && !$scope->allows('roles')): ?>
    <p class="muted">Für dieses Projekt wurden noch keine eigenen Rollen angelegt.</p>
<?php endif ?>
