<?php
use App\Domain\Estimation;

use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;
use function Nafinity\extensions;

$scale    = Estimation::scale($project['estimation_scale'] ?? null);
$offScale = (int) ($offScale ?? 0);
?>
<form method="post" data-enhanced action="<?= s(route('project.update', ['project' => $projectId])) ?>">
    <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
    <fieldset <?= !$scope->allows('manage') ? 'disabled' : '' ?>>
        <label>
            <?= s(t('Name')) ?>
            <input name="name" required maxlength="120" value="<?= s($project['name']) ?>" />
        </label>
        <label>
            <?= s(t('Beschreibung')) ?>
            <textarea name="description" rows="3"><?= s($project['description']) ?></textarea>
        </label>
        <div class="form-grid">
            <label>
                <?= s(t('Farbe')) ?>
                <input type="color" name="color" value="<?= s($project['color']) ?>" />
            </label>
            <label>
                <?= s(t('Symbol')) ?>
                <input name="icon" maxlength="2" value="<?= s($project['icon']) ?>" />
            </label>
            <label>
                <?= s(t('Ticketkürzel')) ?>
                <input
                    name="ticket_key"
                    maxlength="6"
                    pattern="[A-Za-z0-9]{1,6}"
                    value="<?= s($project['ticket_key']) ?>"
                />
                <small><?= s(t('Steht vor jeder Ticketnummer und in ihrer Adresse.')) ?></small>
            </label>
        </div>
        <label>
            <?= s(t('Schätzung')) ?>
            <select name="estimation_scale">
                <?php foreach (extensions()->estimationScales()->all() as $key => $option): ?>
                    <option value="<?= s($key) ?>" <?= $scale === $key ? 'selected' : '' ?>>
                        <?= s(t($option->label)) ?><?= $option->values ? ' · ' . implode(', ', $option->values) : '' ?>
                    </option>
                <?php endforeach ?>
                <?php if (!Estimation::available($project['estimation_scale'] ?? null)): ?>
                    <option value="<?= s((string) $project['estimation_scale']) ?>" selected>
                        <?= s($project['estimation_scale']) ?> · <?= s(t('Erweiterung nicht installiert')) ?>
                    </option>
                <?php endif ?>
            </select>
            <small><?= s(t('Gilt für alle Tickets des Projekts. Nur eine Skala gleichzeitig; das Board summiert sie über jeder Spalte.')) ?></small>
        </label>
        <?php if ($offScale): ?>
            <p class="settings-hint">
                <?= s(t(':count Tickets tragen eine Schätzung, die diese Skala nicht anbietet. Sie bleiben erhalten und sind markiert.', ['count' => $offScale])) ?>
            </p>
        <?php endif ?>
        <div class="form-errors" role="alert"></div>
        <button class="button primary">Projekt speichern</button>
        <?php if ($offScale): ?>
            <button class="button subtle" name="remap_estimates" value="1">
                <?= s(t('Werte auf diese Skala abbilden')) ?>
            </button>
        <?php endif ?>
    </fieldset>
</form>
<?php if ($scope->role === 'owner'): ?>
    <hr />
    <form method="post" data-enhanced action="<?= s(route('project.archive', ['project' => $projectId])) ?>">
        <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
        <input type="hidden" name="action" value="<?= $project['archived_at'] ? 'restore' : 'archive' ?>" />
        <p>Archivierte Projekte bleiben lesbar. Änderungen werden gesperrt.</p>
        <div class="form-errors" role="alert"></div>
        <button class="button subtle"><?= $project['archived_at'] ? t('Projekt wiederherstellen') : t('Projekt archivieren') ?></button>
    </form>
<?php endif ?>
