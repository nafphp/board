<?php
use App\Domain\Estimation;

use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;
use function Nafinity\extensions;
use function Nafinity\field;

$scale    = Estimation::scale($project['estimation_scale'] ?? null);
$offScale = (int) ($offScale ?? 0);

$scaleOptions = [];
foreach (extensions()->estimationScales()->all() as $key => $option) {
    $scaleOptions[$key] = t($option->label)
        . ($option->values ? ' · ' . implode(', ', $option->values) : '');
}

// A scale whose package is gone stays selectable, so saving the card cannot
// silently rewrite it to something else.
$knownScale    = Estimation::available($project['estimation_scale'] ?? null);
$selectedScale = $knownScale ? $scale : (string) $project['estimation_scale'];
if (!$knownScale) {
    $scaleOptions[$selectedScale] = $selectedScale . ' · ' . t('Erweiterung nicht installiert');
}
?>
<form method="post" data-enhanced action="<?= s(route('project.update', ['project' => $projectId])) ?>">
    <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
    <fieldset <?= !$scope->allows('manage') ? 'disabled' : '' ?>>
        <?= field(['label' => 'Name', 'name' => 'name', 'value' => $project['name'], 'required' => true, 'attributes' => ['maxlength' => 120]]) ?>
        <?= field([
            'label'      => 'Beschreibung',
            'name'       => 'description',
            'type'       => 'textarea',
            'value'      => $project['description'],
            'attributes' => ['rows' => 3],
        ]) ?>
        <div class="form-grid">
            <?= field(['label' => 'Farbe', 'name' => 'color', 'type' => 'color', 'value' => $project['color']]) ?>
            <?= field(['label' => 'Symbol', 'name' => 'icon', 'value' => $project['icon'], 'attributes' => ['maxlength' => 2]]) ?>
            <?= field([
                'label'      => 'Ticketkürzel',
                'name'       => 'ticket_key',
                'value'      => $project['ticket_key'],
                'hint'       => 'Steht vor jeder Ticketnummer und in ihrer Adresse.',
                'attributes' => ['maxlength' => 6, 'pattern' => '[A-Za-z0-9]{1,6}'],
            ]) ?>
        </div>
        <?= field([
            'label'   => 'Schätzung',
            'name'    => 'estimation_scale',
            'type'    => 'select',
            'value'   => $selectedScale,
            'options' => $scaleOptions,
            'hint'    => 'Gilt für alle Tickets des Projekts. Nur eine Skala gleichzeitig; das Board summiert sie über jeder Spalte.',
            'choice'  => ['searchLabel' => 'Skalen suchen'],
        ]) ?>
        <?php if ($offScale): ?>
            <p class="settings-hint">
                <?= s(t(':count Tickets tragen eine Schätzung, die diese Skala nicht anbietet. Sie bleiben erhalten und sind markiert.', ['count' => $offScale])) ?>
            </p>
        <?php endif ?>
        <div class="form-errors" role="alert"></div>
        <button class="button primary">Projekt speichern</button>
        <?php if ($offScale): ?>
            <button class="button subtle" name="remap_estimates" value="1">
                <?= s(t('Werte auf diese Skala abbilden')) ?>
            </button>
        <?php endif ?>
    </fieldset>
</form>
<?php if ($scope->role === 'owner'): ?>
    <hr />
    <form method="post" data-enhanced action="<?= s(route('project.archive', ['project' => $projectId])) ?>">
        <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
        <input type="hidden" name="action" value="<?= $project['archived_at'] ? 'restore' : 'archive' ?>" />
        <p>Archivierte Projekte bleiben lesbar. Änderungen werden gesperrt.</p>
        <div class="form-errors" role="alert"></div>
        <button class="button subtle"><?= $project['archived_at'] ? t('Projekt wiederherstellen') : t('Projekt archivieren') ?></button>
    </form>
<?php endif ?>
