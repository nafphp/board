<?php use function Naf\I18n\t; use function Naf\View\s;use function Naf\route;use function Naf\Form\csrf;$this->setLayout('layout');$this->block('content'); ?>
<section class="page-heading"><div><span class="eyebrow"><?= s(t('DEIN WORKSPACE, DEIN RHYTHMUS')) ?></span><h1><?= s(t('Einstellungen')) ?></h1><p><?= s(t('Darstellung und Benachrichtigungen anpassen.')) ?></p></div></section><section class="settings-card preferences-card"><form method="post" data-enhanced action="<?= s(route('preferences.save')) ?>"><input type="hidden" name="_csrf" value="<?= s(csrf()->token()) ?>"><label><?= s(t('Darstellung')) ?><select name="theme"><?php foreach(['system'=>t('Wie mein Gerät'),'light'=>t('Hell'),'dark'=>t('Dunkel')]as$key=>$label): ?><option value="<?= s($key) ?>" <?= $preferences['theme']===$key?'selected':'' ?>><?= s($label) ?></option><?php endforeach ?></select></label><label><?= s(t('Sprache')) ?><select name="locale"><option value="de" <?= $preferences['locale']==='de'?'selected':'' ?>>Deutsch</option><option value="en" <?= $preferences['locale']==='en'?'selected':'' ?>>English</option></select></label><label><?= s(t('Zeitzone')) ?><select name="timezone"><?php foreach(['Europe/Berlin','Europe/London','America/New_York','UTC']as$zone): ?><option value="<?= s($zone) ?>" <?= $preferences['timezone']===$zone?'selected':'' ?>><?= s($zone) ?></option><?php endforeach ?></select></label><div class="checkbox-list"><label><input type="checkbox" name="notify_in_app" value="1" <?= (int)$preferences['notify_in_app']?'checked':'' ?>><?= s(t('Benachrichtigungen in Nafinity')) ?></label><label><input type="checkbox" name="notify_mail" value="1" <?= (int)$preferences['notify_mail']?'checked':'' ?>><?= s(t('Zusätzlich per E-Mail, wenn für den Workspace aktiviert')) ?></label></div><div class="form-errors" role="alert"></div><button class="button primary" style="margin-top:20px"><?= s(t('Einstellungen speichern')) ?></button></form></section><?php if(\Naf\config('auth:logins',[])): ?><section class="settings-card" style="margin-top:24px"><h2>Externe Konten</h2><p>Verknüpfe dein angemeldetes Konto ausdrücklich mit deinem Firmenkonto.</p><?php foreach((array)\Naf\config('auth:logins',[])as$key=>$login): ?><a class="button subtle" href="<?= s(route('oauth.connect',['provider'=>$key])) ?>"><?= s($login['label']??$key) ?> verknüpfen</a><?php endforeach ?></section><?php endif ?><?php $this->endblock('content'); ?>
