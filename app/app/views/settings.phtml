<?php
use App\Domain\Estimation;
use App\Domain\ProjectPermissions;
use App\Support\Format;
use App\Support\Icon;

use function Naf\Form\csrf;
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;
use function Nafinity\partial;
use function Nafinity\template;

$this->setLayout(template('layout'));
$this->block('content');
$projectId      = $project['id'] ?? null;
$token          = csrf()->token();
$availableRoles = ($scope ?? null)?->role === 'owner'
    ? ['owner' => 'Owner', 'manager' => 'Manager', 'member' => 'Member', 'viewer' => 'Viewer']
    : ['member' => 'Member', 'viewer' => 'Viewer'];
if (isset($scope) && $scope->role !== 'owner') {
    $availableRoles = array_filter($availableRoles, fn($label, $role) => !array_diff(ProjectPermissions::defaults($role), $scope->permissions), ARRAY_FILTER_USE_BOTH);
}
foreach ($customRoles ?? [] as $role) {
    if ($scope->role === 'owner' || !array_diff($role['permissions'], $scope->permissions)) {
        $availableRoles['custom:' . $role['id']] = $role['name'];
    }
}
$availableRoles['remove'] = 'Zugriff entziehen';

// Every card shows what is set right now instead of listing the fields it contains.
$themeLabels     = ['system' => t('Wie mein Gerät'), 'light' => t('Hell'), 'dark' => t('Dunkel')];
$personalSummary = implode(' · ', [
    $themeLabels[$preferences['theme']] ?? $preferences['theme'],
    $preferences['locale'] === 'de' ? 'Deutsch' : 'English',
    $preferences['timezone'],
]);
$names = static fn(array $items): string => implode(', ', array_slice(array_column($items, 'name'), 0, 4))
    . (count($items) > 4 ? ' +' . (count($items) - 4) : '');

$cards = [
    ['personal', 'Persönlich', $personalSummary, 'user', 'settings.personal', []],
    ['ai', 'Lokale AI', t('Noch nicht eingerichtet'), 'spark', 'settings.ai', []],
];
if ($projectId !== null) {
    $customCount = count($customRoles ?? []);
    if ($scope->allows('manage') || $scope->allows('restore')) {
        $cards[] = [
            'general',
            'Allgemein',
            ($project['archived_at'] ? t('Archiviert') : t('Aktiv'))
                . ' · ' . $project['ticket_key'] . '-1'
                . ' · ' . t(Estimation::LABELS[Estimation::scale($project['estimation_scale'] ?? null)]),
            'sliders',
            'settings.project',
            [],
        ];
    }
    $rolesDescription = $customCount
        ? Format::count($customCount, 'eigene Rolle', 'eigene Rollen') . ' · ' . t('vier Standardrollen')
        : t('Vier Standardrollen, keine eigenen');
    $cards[] = ['roles', 'Rollen & Rechte', $rolesDescription, 'shield', 'settings.roles', []];
    if ($scope->allows('members')) {
        $cards[] = ['users', 'Mitglieder', $names($members), 'users', 'settings.members', []];
    }
    if ($scope->allows('structure')) {
        foreach (['column' => ['Spalten', $columns], 'swimlane' => ['Swimlanes', $swimlanes], 'label' => ['Labels', $labels]] as $kind => [$heading, $items]) {
            $cards[] = [$kind, $heading, $items ? $names($items) : t('Noch keine angelegt'), $kind, 'settings.structure', compact('kind', 'items')];
        }
    }
}
$viewData = [
    'projectId'      => $projectId,
    'offScale'       => $offScale ?? 0,
    'token'          => $token,
    'scope'          => $scope ?? null,
    'project'        => $project ?? null,
    'preferences'    => $preferences,
    'customRoles'    => $customRoles ?? [],
    'members'        => $members ?? [],
    'availableRoles' => $availableRoles,
    'user'           => $user,
];
$icons = [
    'user'     => 'person',
    'users'    => 'group',
    'spark'    => 'auto_awesome',
    'shield'   => 'shield',
    'sliders'  => 'tune',
    'column'   => 'view_week',
    'swimlane' => 'table_rows',
    'label'    => 'label',
];?>
<section class="page-heading settings-heading">
    <div>
        <span class="eyebrow"><?= s(t($projectId ? 'KONTO & PROJEKT' : 'DEIN KONTO')) ?></span>
        <h1>Einstellungen</h1>
    </div>
    <?php if ($projectId): ?>
        <a class="button subtle" href="<?= s(route('board', ['project' => $projectId])) ?>"><?= Icon::mark('arrow_back', 'sm') ?> Zum Board</a>
    <?php endif ?>
</section>
<div class="settings-context">
    <div>
        <strong><?= s($project['name'] ?? 'Dein Workspace') ?></strong>
        <span>
            <?= $projectId
                ? s(Format::count(count($members), 'Mitglied', 'Mitglieder'))
                    . ' · ' . s(Format::count(4 + count($customRoles ?? []), 'Rolle', 'Rollen'))
                : s(Format::count(count($projects), 'Projekt', 'Projekte')) ?>
        </span>
    </div>
    <label>
        Projekt wechseln
        <select data-settings-project aria-label="Projekt für Einstellungen">
            <option value="/preferences">Nur persönliche Einstellungen</option>
            <?php foreach ($projects as $item): ?>
                <option value="/projects/<?= (int) $item['id'] ?>/settings" <?= (string) $projectId === (string) $item['id'] ? 'selected' : '' ?>>
                    <?= s($item['name']) ?>
                </option>
            <?php endforeach ?>
        </select>
    </label>
</div>
<div class="settings-tiles">
    <?php foreach ($cards as [$id, $label, $description, $icon, $template, $extra]): ?>
        <button
            type="button"
            class="settings-tile"
            data-settings-open="<?= s($id) ?>"
            aria-haspopup="dialog"
            aria-controls="settings-detail"
        >
            <span class="settings-icon"><?= Icon::mark($icons[$icon], 'lg') ?></span>
            <span class="settings-tile-text">
                <strong><?= s($label) ?></strong>
                <small data-settings-summary="<?= s($id) ?>"><?= s($description) ?></small>
            </span>
            <span class="settings-arrow"><?= Icon::mark('open_in_new', 'sm') ?></span>
        </button>
        <section
            hidden
            data-settings-content="<?= s($id) ?>"
            data-title="<?= s($label) ?>"
            data-description="<?= s($description) ?>"
        >
            <?= partial($template, [...$viewData, ...$extra]) ?>
        </section>
    <?php endforeach ?>
</div>
<p class="settings-footnote">
    <?= s(t('Änderungen am Projekt gelten für alle Mitglieder, persönliche Einstellungen nur für dich.')) ?>
</p>
<dialog
    id="settings-detail"
    class="settings-detail"
    aria-labelledby="settings-detail-title"
    aria-describedby="settings-detail-description"
>
    <header class="settings-detail-heading">
        <div class="settings-icon" data-settings-icon></div>
        <div>
            <h2 id="settings-detail-title"></h2>
            <p id="settings-detail-description"></p>
        </div>
        <button
            type="button"
            class="icon-button"
            data-settings-close
            aria-label="Einstellungen schließen"
        >
<?= Icon::mark('close') ?></button>
    </header>
    <div class="settings-detail-body"></div>
</dialog>
<?php $this->endblock('content'); ?>
