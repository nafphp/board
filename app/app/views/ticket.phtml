                                            <svg viewBox="0 0 14 14">
                                                <path class="glyph-play" d="M4.6 2.7 11.2 7 4.6 11.3Z" />
                                                <path class="glyph-pause" d="M4.9 3.2v7.6M9.1 3.2v7.6" />
                                            </svg>
                                        </span>
                                        <time class="timer-readout" data-timer-readout><?= s(sprintf('%d:%02d', intdiv((int) ($timer['seconds'] ?? 0), 60), (int) ($timer['seconds'] ?? 0) % 60)) ?></time>
                                    </span>
                                </button>
                                <span id="timer-hold-hint" class="sr-only">
                                    <?= s(t('Gedrückt halten beendet die Erfassung. Sie läuft auf dem Server weiter, auch wenn du den Tab schließt. Beim Pausieren und Beenden werden die vollen Minuten unter Erfasst gebucht.')) ?>
                                </span>
                                <div class="form-errors" role="alert"></div>
                            </div>
                        <?php endif ?>
                    </dd>
                </dl>
                <div data-ticket-readonly="progress" class="ticket-time-progress">
                    <?php if ((int) $ticket['estimate_minutes'] > 0): ?><progress value="<?= min((int) $ticket['spent_minutes'], (int) $ticket['estimate_minutes']) ?>" max="<?= (int) $ticket['estimate_minutes'] ?>" aria-label="<?= s(t('Erfasster Zeitaufwand')) ?>"></progress><span class="muted small"><?= s($duration(abs((int) $ticket['estimate_minutes'] - (int) $ticket['spent_minutes']))) ?> <?= s(t((int) $ticket['spent_minutes'] > (int) $ticket['estimate_minutes'] ? 'über Schätzung' : 'verbleibend')) ?></span><?php endif ?>
                </div>
            </section>
            <?php if (!$isNew): ?>
            <details class="ticket-sidebar-group ticket-audit" data-ticket-readonly="audit">
                <summary><h2><?= s(t('Informationen')) ?></h2><?= Icon::mark('expand_more', 'sm', 'mi-turn') ?></summary>
