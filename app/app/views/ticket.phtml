                <div class="ticket-kicker"><span class="ticket-key"><?= s(Format::ticket($key, $ticket['number'])) ?></span><span class="ticket-status" data-ticket-readonly="status"><?= s($ticket['archived_at'] ? t('Archiviert') : ($ticket['status'] === 'closed' ? t('Geschlossen') : t('Offen'))) ?></span></div><?php endif ?>
                <?= $field('title', 'Titel', 'text', $ticket['title'], '<h1>' . s($ticket['title']) . '</h1>', [], ['class' => 'ticket-title']) ?>
            </header>
            <section class="ticket-description detail-section">
                <h2><?= s(t('Beschreibung')) ?></h2>
                <?= $field('description', 'Beschreibung', 'rich', RichText::description($ticket), $ticket['description'] === '' ? '<p class="muted">' . s(t('Noch keine Beschreibung.')) . '</p>' : RichText::description($ticket)) ?>
            </section>
            <?php if (!$isNew): ?>
            <section class="detail-section" data-ticket-section="links">
                <h2><?= s(t('Verknüpfte Tickets')) ?><span class="count"><?= count($linked_tickets) ?></span></h2>
                <?php foreach ($linked_tickets as $linked): ?>
                    <div class="ticket-link-row">
                        <a href="<?= s(route('ticket', ['project' => $projectId, 'ticket' => Format::ticket($key, $linked['number'])])) ?>"><span class="ticket-key"><?= s(Format::ticket($key, $linked['number'])) ?></span><span><?= s($linked['title']) ?></span><span class="muted"><?= $linked['status'] === 'closed' ? Icon::mark('check_circle', 'sm') : Icon::mark('radio_button_unchecked', 'sm') ?></span></a>
                        <?php if ($editable): ?>
                            <form method="post" action="<?= s(route('ticket.links', $params)) ?>" data-ticket-form data-refresh-section="links">
                                <input type="hidden" name="_csrf" value="<?= s($token) ?>" /><input type="hidden" name="version" value="<?= (int) $ticket['version'] ?>" /><input type="hidden" name="number" value="<?= (int) $linked['number'] ?>" /><input type="hidden" name="action" value="delete" />
                                <button class="text-button muted" aria-label="<?= s(t('Verknüpfung entfernen')) ?>"><?= Icon::mark('close', 'sm') ?></button><div class="form-errors" role="alert"></div>
                            </form>
                        <?php endif ?>
                    </div>
                <?php endforeach ?>
                <?php if (!$linked_tickets): ?><p class="muted small"><?= s(t('Keine verknüpften Tickets.')) ?></p><?php endif ?>
                <?php if ($editable): ?>
                    <details class="ticket-link-add"><summary class="text-button"><?= s(t('Ticket verknüpfen')) ?></summary>
                        <form method="post" action="<?= s(route('ticket.links', $params)) ?>" data-ticket-form data-refresh-section="links">
                            <input type="hidden" name="_csrf" value="<?= s($token) ?>" /><input type="hidden" name="version" value="<?= (int) $ticket['version'] ?>" />
                            <label><?= s(t('Ticketnummer in diesem Projekt')) ?><span class="ticket-link-input"><span><?= s($key) ?>-</span><input type="number" name="number" min="1" required placeholder="42" /></span></label>
                            <button class="button subtle"><?= s(t('Verknüpfen')) ?></button><div class="form-errors" role="alert"></div>
                        </form>
                    </details>
                <?php endif ?>
            </section>
                <section class="detail-section" data-ticket-section="attachments">
                    <h2>
                        <?= s(t('Anhänge')) ?>
                        <span class="count"><?= count($attachments) ?></span>
                    </h2>
                    <?php foreach ($attachments as $file): ?>
                        <div class="attachment-row">
                            <?php if ($file['state'] === 'ready'): ?>
                                <a href="<?= s(route('attachment.download', ['project' => $projectId, 'ticket' => $params['ticket'], 'attachment' => $file['id']])) ?>"><?= Icon::mark('download', 'sm') ?> <?= s($file['original_name']) ?></a>
                            <?php else: ?>
                                <span><?= s($file['original_name']) ?> · Wird verarbeitet …</span>
                            <?php endif ?>
                            <span class="muted small"><?= number_format((int) $file['byte_size'] / 1024, 1, ',', '.') ?> KiB</span>
                            <?php if ($scope->allows('upload')): ?>
                                <form method="post" data-enhanced action="<?= s(route('attachment.delete', ['project' => $projectId, 'ticket' => $params['ticket'], 'attachment' => $file['id']])) ?>">
                                    <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
                                    <button
                                        class="text-button muted"
                                        aria-label="Anhang <?= s($file['original_name']) ?> löschen"
                                    ><?= Icon::mark('close', 'sm') ?></button>
                                    <div class="form-errors" role="alert"></div>
                                </form>
                            <?php endif ?>
                        </div>
                    <?php endforeach ?>
                    <?php if ($scope->allows('upload') && !$ticket['archived_at']): ?>
                        <form
                            class="upload-form"
                            method="post"
                            enctype="multipart/form-data"
                            data-upload
                            action="<?= s(route('attachment.upload', ['project' => $projectId, 'ticket' => $params['ticket']])) ?>"
                        >
                            <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
                            <label class="dropzone" data-dropzone>
                                <input
                                    type="file"
                                    name="attachment"
                                    required
                                    class="sr-only"
                                    data-upload-input
                                    accept=".txt,.md,.csv,.pdf,.png,.jpg,.jpeg,.webp,.zip"
                                />
                                <span class="dropzone-mark"><?= Icon::mark('attach_file', 'lg') ?></span>
                                <span class="dropzone-words">
                                    <strong><?= s(t('Datei anhängen')) ?></strong>
                                    <small class="muted"><?= s(t('Bis 10 MiB · Text, PDF, Bilder oder ZIP · privat im Projekt')) ?></small>
                                </span>
                            </label>
                            <div class="upload-chosen" hidden data-upload-chosen>
                                <?= Icon::mark('folder_open', 'sm') ?>
                                <span class="upload-name" data-upload-name></span>
                                <span class="muted small" data-upload-size></span>
                                <button
                                    type="button"
                                    class="text-button muted"
                                    data-upload-clear
                                    aria-label="<?= s(t('Auswahl aufheben')) ?>"
                                ><?= Icon::mark('close', 'sm') ?></button>
                            </div>
                            <div class="upload-progress" hidden data-upload-progress>
                                <span class="upload-track"><span class="upload-fill" data-upload-fill></span></span>
                                <span class="muted small" data-upload-percent>0 %</span>
                            </div>
                            <div class="form-errors" role="alert"></div>
                            <button class="button subtle" data-upload-submit><?= s(t('Hochladen')) ?></button>
                        </form>
                    <?php endif ?>
                </section>

            <details class="detail-section ticket-history" data-ticket-section="activity">
                <summary><?= s(t('Verlauf')) ?><span class="count"><?= count($activity) ?></span></summary>
                <ol class="activity-list">
                    <?php foreach ($activity as $item): ?>
                        <li><span class="activity-dot"></span><div><strong><?= s($item['actor_name']) ?></strong><p><?= s(ActivityLabel::for($item['event_type'])) ?></p><time><?= s(Format::dateTime($item['created_at'], $preferences)) ?></time></div></li>
                    <?php endforeach ?>
                </ol>
            </details>
            <section id="comments" class="detail-section ticket-comments">
                <div data-ticket-section="comments">
                    <h2><?= s(t('Kommentare')) ?><span class="count"><?= count(array_filter($comments, static fn(array $comment) => $comment['deleted_at'] === null)) ?></span></h2>
                    <?php
                    $children = [];
foreach ($comments as $comment) {
    $children[$comment['parent_id'] ?? 0][] = $comment;
}
$stack = array_map(static fn(array $comment) => [$comment, 0], array_reverse($children[0] ?? []));
while ($stack) {
    [$comment, $depth] = array_pop($stack);
    foreach (array_reverse($children[$comment['id']] ?? []) as $child) {
        $stack[] = [$child, $depth + 1];
    }
    $handle = $memberHandles[$comment['author_id']] ?? Mentions::handle($comment['author_name']);
    ?>
                        <article class="comment ticket-comment <?= $depth ? 'is-reply' : '' ?>" id="comment-<?= (int) $comment['id'] ?>" style="--reply-depth: <?= min($depth, 3) ?>">
                            <span class="avatar avatar-small"><?= s(mb_substr($comment['author_name'], 0, 1)) ?></span>
                            <div>
                                <div class="comment-byline"><strong><?= s($comment['author_name']) ?></strong><time><?= s(Format::dateTime($comment['created_at'], $preferences)) ?></time></div>
                                <?php if ($comment['deleted_at'] !== null): ?>
                                    <p class="muted"><?= s(t('Kommentar gelöscht.')) ?></p>
                                <?php else: ?>
                                    <p class="comment-body"><?= Mentions::render($comment['body'], $members) ?></p>
                                    <div class="comment-actions">
                                        <?php if ($scope->allows('comment')): ?><button type="button" class="text-button" data-reply="<?= (int) $comment['id'] ?>" data-handle="<?= s($handle) ?>"><?= s(t('Antworten')) ?></button><?php endif ?>
                                        <?php if ($scope->allows('comment') && ((string) $comment['author_id'] === $user->getIdentifier() || $scope->allows('moderate'))): ?>
                                            <details><summary><?= s(t('Bearbeiten')) ?></summary>
                                                <form method="post" action="<?= s(route('ticket.comments', $params)) ?>" data-ticket-form data-refresh-section="comments">
                                                    <input type="hidden" name="_csrf" value="<?= s($token) ?>" /><input type="hidden" name="id" value="<?= (int) $comment['id'] ?>" /><input type="hidden" name="version" value="<?= (int) $comment['version'] ?>" data-comment-version />
                                                    <label class="sr-only" for="comment-edit-<?= (int) $comment['id'] ?>"><?= s(t('Kommentar')) ?></label>
                                                    <textarea id="comment-edit-<?= (int) $comment['id'] ?>" name="body" required maxlength="20000"><?= s($comment['body']) ?></textarea>
                                                    <div class="form-errors" role="alert"></div><div class="inline-actions"><button class="button subtle"><?= s(t('Speichern')) ?></button><button class="text-button danger" name="action" value="delete" formnovalidate><?= s(t('Löschen')) ?></button></div>
                                                </form>
                                            </details>
                                        <?php endif ?>
                                    </div>
                                <?php endif ?>
                            </div>
                        </article>
                    <?php } ?>
                    <?php if (!$comments): ?><p class="muted small"><?= s(t('Noch keine Kommentare.')) ?></p><?php endif ?>
                </div>
            </section>
            <?php if ($scope->allows('comment')): ?>
                <form class="comment-composer" method="post" action="<?= s(route('ticket.comments', $params)) ?>" data-ticket-form data-comment-composer data-refresh-section="comments">
                    <input type="hidden" name="_csrf" value="<?= s($token) ?>" /><input type="hidden" name="parent_id" value="" />
                    <div class="reply-context" hidden><span></span><button type="button" class="text-button" data-cancel-reply aria-label="<?= s(t('Antwort abbrechen')) ?>"><?= Icon::mark('close', 'sm') ?></button></div>
                    <label for="new-comment" class="sr-only"><?= s(t('Kommentar')) ?></label>
                    <textarea id="new-comment" name="body" rows="2" required maxlength="20000" placeholder="<?= s(t('Kommentar schreiben … Mit @ jemanden erwähnen')) ?>" aria-controls="mention-list" aria-expanded="false" aria-autocomplete="list"></textarea>
                    <div class="mention-list" id="mention-list" role="listbox" aria-label="<?= s(t('Projektmitglieder')) ?>" hidden></div>
                    <div class="composer-footer"><span class="muted small"><?= s(t('⌘ / Strg + Enter zum Senden')) ?></span><button type="submit" class="button primary"><?= s(t('Senden')) ?> ↑</button></div>
                    <div class="form-errors" role="alert"></div>
                    <template data-mention-members><?php foreach ($members as $member): ?><span data-handle="<?= s($member['handle']) ?>" data-name="<?= s($member['name']) ?>"></span><?php endforeach ?></template>
                </form>
            <?php endif ?>
            <?php endif ?>
        </div>
        <aside class="ticket-context ticket-sidebar" aria-label="<?= s(t('Ticketdetails')) ?>">
