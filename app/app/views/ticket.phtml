<?php

use App\Domain\Estimation;
use App\Support\Duration;
use App\Support\Format;
use App\Support\Icon;
use App\Support\Mentions;
use App\Support\RichText;

use function Naf\Form\csrf;
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;
use function Nafinity\partial;
use function Nafinity\slot;
use function Nafinity\template;

$isNew = $ticket === null;
$ticket ??= [
    'id'            => null, 'number' => null, 'version' => 0,
    'title'         => '', 'description' => '', 'description_html' => null,
    'column_id'     => $columns[0]['id'], 'swimlane_id' => $swimlanes[0]['id'],
    'status'        => 'open', 'priority' => 'normal', 'color' => '#6366f1',
    'start_date'    => null, 'due_date' => null, 'estimate_minutes' => null,
    'spent_minutes' => 0, 'estimate_points' => null, 'archived_at' => null,
];
if (!$fragment) {
    $this->setLayout(template('layout'));
    $this->block('content');
}
$projectId = $project['id'];
$key       = $project['ticket_key'];
$params    = [
    'project' => $projectId,
    'ticket'  => $isNew ? 'new' : Format::ticket($key, $ticket['number']),
];
$editable      = $scope->allows('write') && !$ticket['archived_at'];
$targets       = $targets ?? [];
$token         = csrf()->token();
$members       = Mentions::members($members);
$memberNames   = array_column($members, 'name', 'id');
$memberHandles = array_column($members, 'handle', 'id');
$priorities    = ['low' => t('Niedrig'), 'normal' => t('Normal'), 'high' => t('Hoch'), 'urgent' => t('Dringend')];
$empty         = '<span class="muted">' . s(t('Nicht festgelegt')) . '</span>';
$field         = static function (string $name, string $label, string $type, mixed $value, string $display, array $options = [], array $extra = []) use ($ticket, $board, $token, $params, $editable, $isNew): string {
    return partial('ticket/field', [
        'name'    => $name, 'label' => $label, 'type' => $type, 'value' => $value,
        'display' => $display, 'options' => $options, 'editable' => $editable,
        'ticket'  => $ticket, 'board' => $board, 'token' => $token,
        'action'  => route('ticket.update', $params), 'creating' => $isNew, ...$extra,
    ]);
};
$duration = static fn(?int $minutes): string => $minutes === null ? t('Nicht geschätzt') : Duration::format($minutes);

// Sidebar groups are contributions, so a plugin adds a panel or a field without
// this view knowing its name. The data the core panels already have is handed
// along rather than looked up a second time.
$metaFields = [];
foreach ($metaDefinitions ?? [] as $metaKey => $metaDefinition) {
    $metaFields[$metaDefinition->group][$metaKey] = $metaDefinition;
}

// The scale decides which values are offered, not which are storable. A value left over
// from an earlier scale stays selectable, so opening the ticket cannot silently drop it.
$scale        = Estimation::scale($project['estimation_scale'] ?? null);
$estimating   = Estimation::active($scale);
$estimateUnit = Estimation::UNITS[$scale] ?? '';
$points       = $ticket['estimate_points'] === null ? null : (int) $ticket['estimate_points'];
$pointValues  = Estimation::values($scale);
if ($points !== null && !in_array($points, $pointValues, true)) {
    $pointValues[] = $points;
    sort($pointValues);
}
$pointOptions = ['' => t('Nicht geschätzt')];
foreach ($pointValues as $value) {
    $pointOptions[$value] = $value . ' ' . $estimateUnit
        . (Estimation::offScale($scale, $value) ? ' · ' . t('außerhalb der Skala') : '');
}
$pointDisplay = $points === null
    ? $empty
    : '<span class="ticket-points' . (Estimation::offScale($scale, $points) ? ' off-scale' : '') . '">'
        . $points . '<small>' . s($estimateUnit) . '</small></span>'
        . (Estimation::offScale($scale, $points)
            ? '<span class="muted small"> ' . s(t('außerhalb der Skala')) . '</span>'
            : '');
$selectedNames   = array_intersect_key($memberNames, array_flip($selected_assignees));
$assigneeDisplay = '';
if ($selectedNames) {
    $firstName       = reset($selectedNames);
    $assigneeDisplay = '<span class="ticket-person"><span class="avatar avatar-small">' . s(mb_substr($firstName, 0, 1)) . '</span>' . s($firstName);
    if (count($selectedNames) > 1) {
        $assigneeDisplay .= '<span class="choice-count" title="' . s(implode(', ', $selectedNames)) . '">+' . (count($selectedNames) - 1) . '</span>';
    }
    $assigneeDisplay .= '</span>';
}
$labelDisplay = '';
foreach ($labels as $label) {
    if (in_array($label['id'], $selected_labels)) {
        $labelDisplay .= '<span class="label-tag" style="--tag-color:' . s($label['color']) . '">' . s($label['name']) . '</span> ';
    }
}

// Everything the built-in panels already hold, handed to the slot so that no
// contribution has to load it again. A contribution's own provider still wins.
$panelData = [
    'activity'           => $activity ?? [],
    'assigneeDisplay'    => $assigneeDisplay,
    'attachments'        => $attachments ?? [],
    'board'              => $board,
    'columns'            => $columns,
    'creator'            => $creator ?? '',
    'duration'           => $duration,
    'editable'           => $editable,
    'empty'              => $empty,
    'estimating'         => $estimating,
    'field'              => $field,
    'isNew'              => $isNew,
    'key'                => $key,
    'labelDisplay'       => $labelDisplay,
    'labels'             => $labels,
    'linked_tickets'     => $linked_tickets ?? [],
    'memberNames'        => $memberNames,
    'metaFields'         => $metaFields,
    'metadata'           => $metadata ?? [],
    'params'             => $params,
    'pointDisplay'       => $pointDisplay,
    'pointOptions'       => $pointOptions,
    'points'             => $points,
    'preferences'        => $preferences,
    'priorities'         => $priorities,
    'project'            => $project,
    'projectId'          => $projectId,
    'scale'              => $scale,
    'scope'              => $scope,
    'selected_assignees' => $selected_assignees,
    'selected_labels'    => $selected_labels,
    'swimlanes'          => $swimlanes,
    'targets'            => $targets,
    'ticket'             => $ticket,
    'timer'              => $timer ?? [],
    'token'              => $token,
];
?>
<div class="ticket-detail ticket-workspace <?= $fragment ? 'in-drawer' : '' ?> <?= $isNew ? 'ticket-creating' : '' ?>" data-ticket-url="<?= s(route('ticket', $params)) ?>" data-version="<?= (int) $ticket['version'] ?>" data-revision="<?= (int) $board['revision'] ?>" data-mode="<?= $isNew ? 'create' : 'detail' ?>" data-project="<?= (int) $projectId ?>" data-ticket="<?= (int) ($ticket['id'] ?? 0) ?>">
    <div class="detail-topline">
        <a class="back-link" href="<?= s(route('board', ['project' => $projectId])) ?>" <?= $fragment ? 'data-close-drawer' : '' ?>><?= Icon::mark('arrow_back', 'sm') ?><span><?= $fragment ? s($project['name']) : s(t('Zurück zum Board')) ?></span></a>
        <span class="ticket-save-state" role="status" aria-live="polite"></span>
        <?php if ($fragment): ?><button type="button" class="icon-button" data-close-drawer aria-label="<?= s(t('Ticket schließen')) ?>"><?= Icon::mark('close') ?></button><?php endif ?>
    </div>
    <?php if ($isNew): ?>
        <form method="post" action="<?= s(route('ticket.create', ['project' => $projectId])) ?>" data-ticket-form data-ticket-create>
            <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
            <input type="hidden" name="board_revision" value="<?= (int) $board['revision'] ?>" />
    <?php endif ?>
    <div class="ticket-detail-grid">
        <div class="ticket-main">
            <header class="ticket-heading">
                <?php if ($isNew): ?><div class="ticket-kicker"><span class="ticket-key"><?= s(t('Neues Ticket')) ?></span></div><?php else: ?>
                <div class="ticket-kicker"><span class="ticket-key"><?= s(Format::ticket($key, $ticket['number'])) ?></span><span class="ticket-status" data-ticket-readonly="status"><?= s($ticket['archived_at'] ? t('Archiviert') : ($ticket['status'] === 'closed' ? t('Geschlossen') : t('Offen'))) ?></span></div><?php endif ?>
                <?= $field('title', 'Titel', 'text', $ticket['title'], '<h1>' . s($ticket['title']) . '</h1>', [], ['class' => 'ticket-title']) ?>
            </header>
            <section class="ticket-description detail-section">
                <h2><?= s(t('Beschreibung')) ?></h2>
                <?= $field('description', 'Beschreibung', 'rich', RichText::description($ticket), $ticket['description'] === '' ? '<p class="muted">' . s(t('Noch keine Beschreibung.')) . '</p>' : RichText::description($ticket)) ?>
            </section>
            <?php if (!$isNew): ?>
            <div data-widget-slot="ticket.main.widgets">
                <?= slot('ticket.main.widgets', $uiContext, $panelData) ?>
            </div>
            <section id="comments" class="detail-section ticket-comments">
                <div data-ticket-section="comments">
                    <h2><?= s(t('Kommentare')) ?><span class="count"><?= count(array_filter($comments, static fn(array $comment) => $comment['deleted_at'] === null)) ?></span></h2>
                    <?php
                    $children = [];
                foreach ($comments as $comment) {
                    $children[$comment['parent_id'] ?? 0][] = $comment;
                }
                $stack = array_map(static fn(array $comment) => [$comment, 0], array_reverse($children[0] ?? []));
                while ($stack) {
                    [$comment, $depth] = array_pop($stack);
                    foreach (array_reverse($children[$comment['id']] ?? []) as $child) {
                        $stack[] = [$child, $depth + 1];
                    }
                    $handle = $memberHandles[$comment['author_id']] ?? Mentions::handle($comment['author_name']);
                    ?>
                        <article class="comment ticket-comment <?= $depth ? 'is-reply' : '' ?>" id="comment-<?= (int) $comment['id'] ?>" style="--reply-depth: <?= min($depth, 3) ?>">
                            <span class="avatar avatar-small"><?= s(mb_substr($comment['author_name'], 0, 1)) ?></span>
                            <div>
                                <div class="comment-byline"><strong><?= s($comment['author_name']) ?></strong><time><?= s(Format::dateTime($comment['created_at'], $preferences)) ?></time></div>
                                <?php if ($comment['deleted_at'] !== null): ?>
                                    <p class="muted"><?= s(t('Kommentar gelöscht.')) ?></p>
                                <?php else: ?>
                                    <p class="comment-body"><?= Mentions::render($comment['body'], $members) ?></p>
                                    <div class="comment-actions">
                                        <?php if ($scope->allows('comment')): ?><button type="button" class="text-button" data-reply="<?= (int) $comment['id'] ?>" data-handle="<?= s($handle) ?>"><?= s(t('Antworten')) ?></button><?php endif ?>
                                        <?php if ($scope->allows('comment') && ((string) $comment['author_id'] === $user->getIdentifier() || $scope->allows('moderate'))): ?>
                                            <details><summary><?= s(t('Bearbeiten')) ?></summary>
                                                <form method="post" action="<?= s(route('ticket.comments', $params)) ?>" data-ticket-form data-refresh-section="comments">
                                                    <input type="hidden" name="_csrf" value="<?= s($token) ?>" /><input type="hidden" name="id" value="<?= (int) $comment['id'] ?>" /><input type="hidden" name="version" value="<?= (int) $comment['version'] ?>" data-comment-version />
                                                    <label class="sr-only" for="comment-edit-<?= (int) $comment['id'] ?>"><?= s(t('Kommentar')) ?></label>
                                                    <textarea id="comment-edit-<?= (int) $comment['id'] ?>" name="body" required maxlength="20000"><?= s($comment['body']) ?></textarea>
                                                    <div class="form-errors" role="alert"></div><div class="inline-actions"><button class="button subtle"><?= s(t('Speichern')) ?></button><button class="text-button danger" name="action" value="delete" formnovalidate><?= s(t('Löschen')) ?></button></div>
                                                </form>
                                            </details>
                                        <?php endif ?>
                                    </div>
                                <?php endif ?>
                            </div>
                        </article>
                    <?php } ?>
                    <?php if (!$comments): ?><p class="muted small"><?= s(t('Noch keine Kommentare.')) ?></p><?php endif ?>
                </div>
            </section>
            <?php if ($scope->allows('comment')): ?>
                <form class="comment-composer" method="post" action="<?= s(route('ticket.comments', $params)) ?>" data-ticket-form data-comment-composer data-refresh-section="comments">
                    <input type="hidden" name="_csrf" value="<?= s($token) ?>" /><input type="hidden" name="parent_id" value="" />
                    <div class="reply-context" hidden><span></span><button type="button" class="text-button" data-cancel-reply aria-label="<?= s(t('Antwort abbrechen')) ?>"><?= Icon::mark('close', 'sm') ?></button></div>
                    <label for="new-comment" class="sr-only"><?= s(t('Kommentar')) ?></label>
                    <textarea id="new-comment" name="body" rows="2" required maxlength="20000" placeholder="<?= s(t('Kommentar schreiben … Mit @ jemanden erwähnen')) ?>" aria-controls="mention-list" aria-expanded="false" aria-autocomplete="list"></textarea>
                    <div class="mention-list" id="mention-list" role="listbox" aria-label="<?= s(t('Projektmitglieder')) ?>" hidden></div>
                    <div class="composer-footer"><span class="muted small"><?= s(t('⌘ / Strg + Enter zum Senden')) ?></span><button type="submit" class="button primary"><?= s(t('Senden')) ?> ↑</button></div>
                    <div class="form-errors" role="alert"></div>
                    <template data-mention-members><?php foreach ($members as $member): ?><span data-handle="<?= s($member['handle']) ?>" data-name="<?= s($member['name']) ?>"></span><?php endforeach ?></template>
                </form>
            <?php endif ?>
            <?php endif ?>
        </div>
        <aside class="ticket-context ticket-sidebar" aria-label="<?= s(t('Ticketdetails')) ?>">
            <?= slot('ticket.sidebar.panels', $uiContext, $panelData) ?>
        </aside>
    </div>
    <?php if ($isNew): ?>
        <div class="ticket-create-footer">
            <div class="form-errors" role="alert"></div>
            <div class="ticket-create-actions"><span class="muted small"><?= s(t('Titel ist erforderlich. Weitere Angaben sind optional.')) ?></span>
                <a class="button subtle" href="<?= s(route('board', ['project' => $projectId])) ?>" <?= $fragment ? 'data-close-drawer' : '' ?>><?= s(t('Abbrechen')) ?></a>
                <button type="submit" class="button primary"><?= s(t('Ticket erstellen')) ?></button>
            </div>
        </div>
        </form>
    <?php endif ?>
</div>
<?php if (!$fragment) {
    $this->endblock('content');
} ?>
