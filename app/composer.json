{
  "name": "fkde/nafinity",
  "description": "A project-isolated Kanban application and NAF showcase.",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "ext-fileinfo": "*",
    "naf/framework": "^0.2.4",
    "naf/database": "^0.2.2",
    "naf/form": "^0.2.3",
    "naf/session": "^0.2.2",
    "naf/orm": "^0.2.2",
    "naf/queue": "^0.2.3",
    "naf/schedule": "^0.2.3",
    "naf/mail": "^0.2.2",
    "naf/auth": "^0.2.1",
    "naf/view": "^0.2.1",
    "naf/cli": "^0.2.2",
    "naf/i18n": "^0.2.2",
    "naf/client": "^0.2.2",
    "naf/oauth-client": "^0.2.2",
    "naf/storage": "^0.1.0",
    "naf/rate-limit": "^0.1.0",
    "naf/auth-ldap": "^0.1.0",
    "naf/mcp": "^0.2.1",
    "symfony/html-sanitizer": "^7.4",
    "ext-dom": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Nafinity\\": "app/Extensions/"
    },
    "files": [
      "app/functions.php"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "conflict": {
    "nyholm/psr7": "<1.8.2"
  }
}
