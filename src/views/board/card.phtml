<?php

use Naf\Board\Domain\Estimation;
use Naf\Board\Support\Format;
use Naf\Board\Support\Icon;

use function Naf\Board\slot;
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;

/**
 * One card, wherever it is asked for.
 *
 * The board page renders these into a grid; the JSON endpoint renders the same
 * template and hands them over by id, so a card that arrives with a live update
 * is the card the page would have drawn. That is the whole reason this is a file
 * of its own: two renderers would be two truths about what a card shows, and the
 * extension slots below would only exist in one of them.
 *
 * Everything it needs that is not the card itself comes in `$board` -- the
 * project, what the viewer may do, and the lookups a loop would otherwise
 * rebuild for every card.
 */
[
    'canDrag'         => $canDrag,
    'canWrite'        => $canWrite,
    'project'         => $project,
    'projectId'       => $projectId,
    'running_timers'  => $running_timers,
    'prioritySymbols' => $prioritySymbols,
    'unknownPriority' => $unknownPriority,
    'boardSlot'       => $boardSlot,
    'tags'            => $tags,
    'labelMap'        => $labelMap,
    'estimating'      => $estimating,
    'scale'           => $scale,
    'estimateUnit'    => $estimateUnit,
    'assignments'     => $assignments,
    'memberMap'       => $memberMap,
] = $board;
?>
    <article
        class="ticket-card"
        draggable="<?= $canDrag ? 'true' : 'false' ?>"
        data-ticket="<?= (int) $card['id'] ?>"
        data-key="<?= s(Format::ticket($project['ticket_key'], $card['number'])) ?>"
        data-version="<?= (int) $card['version'] ?>"
        data-status="<?= s($card['status']) ?>"
        data-title="<?= s($card['title']) ?>"
        data-points="<?= (int) $card['estimate_points'] ?>"
    >
        <div class="card-top">
            <?php /* Everything that says what this ticket *is* stands together on
                     the left: its priority, its number, the tick a closed one
                     wears and the pulse of a running timer. The right side is
                     then only what you can do to it. */ ?>
            <span class="card-id">
                <span
                    class="priority priority-<?= s($card['priority']) ?>"
                    title="<?= s($card['priority']) ?>"
                >
                    <?= $prioritySymbols[$card['priority']] ?? $unknownPriority ?>
                </span>
                <span class="ticket-number"><?= s(Format::ticket($project['ticket_key'], $card['number'])) ?></span>
                <?php if (in_array((int) $card['id'], $running_timers, true)): ?>
                    <span class="timer-pulse" title="<?= s(t('Deine Zeiterfassung läuft')) ?>"></span>
                <?php endif ?>
            </span>
            <div>
                <?php if ($canWrite && !$card['archived_at']): ?>
                    <button
                        type="button"
                        class="card-menu"
                        data-move-card
                        aria-label="<?= s(t('Ticket :key verschieben', ['key' => Format::ticket($project['ticket_key'], $card['number'])])) ?>"
                    >
<?= Icon::mark('more_horiz') ?>                                            </button>
                <?php endif ?>
                <?= slot('board.card.actions', $boardSlot->withCard($card)) ?>
            </div>
        </div>
        <a class="card-title" data-ticket-link href="<?= s(route('ticket', ['project' => $projectId, 'ticket' => Format::ticket($project['ticket_key'], $card['number'])])) ?>">
            <?= s($card['title']) ?>
        </a>
        <p class="card-description"><?= s(mb_strimwidth($card['description'], 0, 95, '…')) ?></p>
        <div class="card-labels">
            <?php foreach ($tags[$card['id']] ?? [] as $labelId): ?>
                <?php $label = $labelMap[$labelId]; ?>
                <span class="label-tag" style="--tag-color: <?= s($label['color']) ?>">
                    <?= s($label['name']) ?>
                </span>
            <?php endforeach ?>
            <?= slot('board.card.badges', $boardSlot->withCard($card)) ?>
        </div>
        <?= slot('board.card.details', $boardSlot->withCard($card)) ?>
        <?php
/*
 * The footer, and only when it has something to say.
 *
 * It used to print "Kein Termin" on every card that had no date -- a line
 * announcing the absence of a thing, on the majority of cards, above a rule
 * drawn to separate it from what is now nothing. A date says something; not
 * having one does not, and the card is shorter for it.
 */
$people = array_values(array_filter(
    $assignments[$card['id']] ?? [],
    static fn($userId) => isset($memberMap[$userId]),
));
$points = $estimating && $card['estimate_points'] !== null;
?>
        <?php if ($card['due_date'] || $points || $people !== []): ?>
            <div class="card-bottom">
                <?php if ($card['due_date']): ?>
                    <span class="due-date">
                        <?= Icon::mark('schedule', 'sm') ?>
                        <?= s(date('d. M', strtotime((string) $card['due_date']))) ?>
                    </span>
                <?php endif ?>
                <?php if ($points): ?>
                    <span
                        class="card-points <?= Estimation::offScale($scale, (int) $card['estimate_points']) ? 'off-scale' : '' ?>"
                        title="<?= s(Estimation::offScale($scale, (int) $card['estimate_points'])
                            ? t('Wert außerhalb der Skala dieses Projekts')
                            : t(Estimation::label($scale))) ?>"
                    >
                        <?= s(Estimation::display($scale, (int) $card['estimate_points'])) ?><small><?= s($estimateUnit) ?></small>
                    </span>
                <?php endif ?>
                <div class="card-assignees">
                    <?php foreach ($people as $userId): ?>
                        <span class="avatar tiny" title="<?= s($memberMap[$userId]['name']) ?>">
                            <?= s(mb_substr($memberMap[$userId]['name'], 0, 1)) ?>
                        </span>
                    <?php endforeach ?>
                </div>
            </div>
        <?php endif ?>
    </article>
