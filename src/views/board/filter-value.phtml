<?php

use function Naf\Board\partial;
use function Naf\View\s;

// Query-only filters must survive changing a visible control as well.
?>
<?php if (is_array($value)): ?>
    <?php foreach ($value as $key => $entry): ?>
        <?= partial('board/filter-value', ['name' => $name . '[' . $key . ']', 'value' => $entry]) ?>
    <?php endforeach ?>
<?php else: ?>
    <input type="hidden" name="<?= s($name) ?>" value="<?= s(is_bool($value) ? (int) $value : $value) ?>" />
<?php endif ?>
