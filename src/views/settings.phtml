<?php
use Naf\Board\Domain\ProjectPermissions;
use Naf\Board\Support\Icon;
use Naf\Board\Support\Resolver;

use function Naf\app;
use function Naf\Board\extensions;
use function Naf\Board\partial;
use function Naf\Board\template;
use function Naf\Form\csrf;
use function Naf\I18n\t;
use function Naf\View\s;

$this->setLayout(template('layout'));
$this->block('content');
$projectId      = $project['id'] ?? null;
$token          = csrf()->token();
$availableRoles = ($scope ?? null)?->role === 'owner'
    ? ['owner' => 'Owner', 'manager' => 'Manager', 'member' => 'Member', 'viewer' => 'Viewer']
    : ['member' => 'Member', 'viewer' => 'Viewer'];
if (isset($scope) && $scope->role !== 'owner') {
    $availableRoles = array_filter($availableRoles, fn($label, $role) => !array_diff(ProjectPermissions::defaults($role), $scope->permissions), ARRAY_FILTER_USE_BOTH);
}
foreach ($customRoles ?? [] as $role) {
    if ($scope->role === 'owner' || !array_diff($role['permissions'], $scope->permissions)) {
        $availableRoles['custom:' . $role['id']] = $role['name'];
    }
}
$availableRoles['remove'] = 'Zugriff entziehen';

// Cards come from the registry, so an extension adds one without this page
// learning its name. Each card says for itself what it currently holds -- out of
// this, so whatever a card may need has to be in here. A key missing from this
// list is not an empty card, it is a card that quietly shows nothing.
$viewData = [
    'projectId'      => $projectId,
    'columns'        => $columns ?? [],
    'swimlanes'      => $swimlanes ?? [],
    'labels'         => $labels ?? [],
    'offScale'       => $offScale ?? 0,
    'token'          => $token,
    'scope'          => $scope ?? null,
    'project'        => $project ?? null,
    'preferences'    => $preferences,
    'customRoles'    => $customRoles ?? [],
    'members'        => $members ?? [],
    'availableRoles' => $availableRoles,
    'user'           => $user,
    'projects'       => $projects,
];
// A project shows what belongs to the project; the account shows what belongs
// to the account. They used to be one list, so every project repeated the two
// account cards and the gear in the sidebar meant one thing here and another
// there.
$cards = [];
$scopes ??= $projectId === null ? ['user'] : ['project', 'project_user'];
foreach ($scopes as $cardScope) {
    foreach (extensions()->settingSections()->forScope($cardScope) as $id => $section) {
        if (!$uiContext->allows($section->permission)) {
            continue;
        }
        $data = $section->provider === null
            ? []
            : Resolver::service(app()->container(), $section->provider)
                ->data($section, $uiContext, $viewData);
        if (($data['visible'] ?? true) === false) {
            continue;
        }
        $cards[] = [
            $id,
            t($section->label),
            (string) ($data['description'] ?? ''),
            $section->icon ?? 'tune',
            $section->template ?? 'settings/fields',
            [...$data, 'section' => $section, 'scope' => $scope ?? null],
        ];
    }
}
?>
<?php if ($projectId): ?>
    <?= partial('project/header', [
        'project' => $project,
        'scope'   => $scope,
        'members' => $members,
        'total'   => $total,
        'view'    => 'settings',
    ]) ?>
<?php else: ?>
    <section class="page-heading settings-heading">
        <div>
            <span class="eyebrow"><?= s(t($eyebrow ?? 'DEIN KONTO')) ?></span>
            <h1><?= s(t($heading ?? 'Einstellungen')) ?></h1>
            <p><?= s(t($lede ?? 'Gelten für dich, in jedem Projekt.')) ?></p>
        </div>
    </section>
<?php endif ?>
<div class="settings-tiles">
    <?php foreach ($cards as [$id, $label, $description, $icon, $template, $extra]): ?>
        <button
            type="button"
            class="settings-tile"
            data-settings-open="<?= s($id) ?>"
            aria-haspopup="dialog"
            aria-controls="settings-detail"
        >
            <span class="settings-icon"><?= Icon::mark($icon, 'lg') ?></span>
            <span class="settings-tile-text">
                <strong><?= s($label) ?></strong>
                <small data-settings-summary="<?= s($id) ?>"><?= s($description) ?></small>
            </span>
            <span class="settings-arrow"><?= Icon::mark('open_in_new', 'sm') ?></span>
        </button>
        <section
            hidden
            data-settings-content="<?= s($id) ?>"
            data-title="<?= s($label) ?>"
            data-description="<?= s($description) ?>"
        >
            <?= partial($template, [...$viewData, ...$extra]) ?>
        </section>
    <?php endforeach ?>
</div>
<?php if ($projectId): ?>
    <p class="settings-footnote">
        <?= s(t(
            'Änderungen hier gelten für alle Mitglieder dieses Projekts. Was nur für dich gilt, '
            . 'steht unter „Für mich in diesem Projekt“ und in deinen Kontoeinstellungen.',
        )) ?>
    </p>
<?php endif ?>
<dialog
    id="settings-detail"
    class="settings-detail"
    aria-labelledby="settings-detail-title"
    aria-describedby="settings-detail-description"
>
    <header class="settings-detail-heading">
        <div class="settings-icon" data-settings-icon></div>
        <div>
            <h2 id="settings-detail-title"></h2>
            <p id="settings-detail-description"></p>
        </div>
        <button
            type="button"
            class="icon-button"
            data-settings-close
            aria-label="Einstellungen schließen"
        >
<?= Icon::mark('close') ?></button>
    </header>
    <div class="settings-detail-body"></div>
</dialog>
<?php $this->endblock('content'); ?>
