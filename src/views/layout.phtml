        <?php
        /*
         * Where the browser connects, the token that says what it may hear, and
         * where to ask for the next one. Issued here because this is the last
         * moment with a request, and a request is what makes "may this person
         * hear this board" cheap to answer -- the socket server has no session
         * to ask.
         *
         * Nothing is rendered when an installation has no server. The client
         * module then finds no settings and does nothing, which is the whole of
         * what switching it off has to do.
         */
        $socket = $current === null ? null : LiveConnection::forProject(
            (int) $current,
            (string) $user->getIdentifier(),
        );
?>
        <?php if ($socket !== null): ?>
            <script type="application/json" data-naf-websocket><?= json_encode($socket, JSON_THROW_ON_ERROR | JSON_HEX_TAG | JSON_HEX_AMP) ?></script>
