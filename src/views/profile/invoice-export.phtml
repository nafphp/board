}
$invoiceField = static fn(array $properties): string => field(['id' => 'invoice-export-' . $properties['name'], ...$properties]);
?>
<?php if ($invoiceFormats !== [] && $boards !== []): ?>
<details class="profile-section" name="profile-section" data-profile-section-id="invoice_export">
    <summary>
        <span class="profile-section-icon" aria-hidden="true"><?= Icon::mark('download', 'sm') ?></span>
        <span><strong><?= s(t('Rechnungspositionen exportieren')) ?></strong><small><?= s(t('Eigene Stunden für dein Rechnungstool aufbereiten')) ?></small></span>
        <span class="profile-chevron" aria-hidden="true"><?= Icon::mark('expand_more', 'sm') ?></span>
    </summary>
    <form method="get" action="<?= s(route('profile.invoice_export')) ?>" class="profile-form">
        <?= $invoiceField(['label' => 'Board', 'name' => 'project', 'type' => 'select', 'options' => $boards]) ?>
        <?= $invoiceField(['label' => 'Format', 'name' => 'format', 'type' => 'select', 'value' => 'invoice.csv', 'options' => $invoiceFormats]) ?>
        <div class="form-grid">
            <?= $invoiceField(['label' => 'Gebucht ab', 'name' => 'from', 'type' => 'date']) ?>
            <?= $invoiceField(['label' => 'Gebucht bis', 'name' => 'until', 'type' => 'date']) ?>
        </div>
        <div class="form-grid">
            <?= $invoiceField(['label' => 'Netto-Stundensatz (EUR)', 'name' => 'rate', 'type' => 'text', 'required' => true]) ?>
            <?= $invoiceField(['label' => 'Steuersatz (%)', 'name' => 'tax', 'type' => 'text', 'required' => true]) ?>
