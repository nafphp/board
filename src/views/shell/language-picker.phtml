<?php

/**
 * The language of the top bar.
 *
 * The control is the application's own select, so the list opens in the page
 * instead of in the platform's menu and looks like every other select here. The
 * native control it covers stays underneath and carries the form value. The open
 * list fits its entries: a top bar has no room for a form field's width.
 *
 * @var array  $preferences
 * @var string $token
 */

use Naf\Board\Support\Locales;

use function Naf\Board\choice;
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;

$languages = Locales::available();
$flags     = [];
foreach ($languages as $code => $name) {
    $flags[$code] = ['mark' => Locales::flag($code)];
}
?>
<form
    class="language-picker"
    method="post"
    action="<?= s(route('preferences.language')) ?>"
    data-language-picker
>
    <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
    <?= choice([
        'name'        => 'locale',
        'label'       => 'Sprache wählen',
        'value'       => $preferences['locale'],
        'options'     => $languages,
        'optionData'  => $flags,
        'id'          => 'locale-picker',
        'searchLabel' => 'Sprachen suchen',
        'width'       => 'fit',
    ]) ?>
    <noscript><button class="button subtle"><?= s(t('Wechseln')) ?></button></noscript>
</form>
