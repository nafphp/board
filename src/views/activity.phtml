<?php

use Naf\Board\Support\ActivityLabel;
use Naf\Board\Support\Format;

use function Naf\Board\partial;
use function Naf\Board\slot;
use function Naf\Board\template;
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;

$this->setLayout(template('layout'));
$this->block('content');
?>
<?= partial('project/header', [
    'project' => $project,
    'scope'   => $scope,
    'members' => $members,
    'total'   => $total,
    'view'    => 'activity',
    'actions' => slot('activity.actions', $uiContext),
]) ?>
<p class="muted small">
    <?= count($activity) >= 100
        ? s(t('Die letzten 100 Einträge'))
        : s(Format::count(count($activity), 'Eintrag', 'Einträge')) ?>
</p>
<section class="settings-card preferences-card">
    <ol class="activity-list">
        <?php foreach ($activity as $item): ?>
            <li>
                <span class="activity-dot"></span>
                <div>
                    <strong><?= s($item['actor_name']) ?></strong>
                    <p>
                        <?= s(ActivityLabel::for($item['event_type'])) ?>
                        <?php if ($item['ticket_id']): ?>
                            ·
                            <a href="<?= s(route('ticket', ['project' => $project['id'], 'ticket' => Format::ticket($project['ticket_key'], $item['ticket_number'])])) ?>"><?= s(Format::ticket($project['ticket_key'], $item['ticket_number'])) ?></a>
                        <?php endif ?>
                    </p>
                    <time><?= s(Format::dateTime($item['created_at'], $preferences)) ?></time>
                </div>
            </li>
        <?php endforeach ?>
    </ol>
</section>
<?php $this->endblock('content'); ?>
