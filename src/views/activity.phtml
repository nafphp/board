    'actions' => slot('activity.actions', $uiContext),
]) ?>
<p class="muted small">
    <?= count($activity) >= 100
        ? s(t('Die letzten 100 Einträge'))
        : s(Format::count(count($activity), 'Eintrag', 'Einträge')) ?>
</p>
<section class="settings-card preferences-card">
    <ol
        class="activity-list"
        data-activity
        data-project="<?= (int) $project['id'] ?>"
        data-entries="<?= s(route('project.activity.entries', ['project' => $project['id']])) ?>"
        data-latest="<?= (int) ($activity[0]['id'] ?? 0) ?>"
    >
