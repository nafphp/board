<?php

use Naf\Board\Domain\Estimation;
use Naf\Board\Support\BoardSlotContext;
use Naf\Board\Support\Format;
use Naf\Board\Support\Icon;

use function Naf\Board\choice;
use function Naf\Board\extensions;
use function Naf\Board\partial;
use function Naf\Board\slot;
use function Naf\Board\template;
use function Naf\Form\csrf;
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;

$this->setLayout(template('layout'));
$this->block('content');
$canWrite  = $scope->allows('write');
$isLimited = $total > 300;
$canDrag   = $canWrite && !$filters && !$isLimited;

$token        = csrf()->token();
$projectId    = $project['id'];
$labelMap     = array_column($labels, null, 'id');
$memberMap    = array_column($members, null, 'id');
$columnCounts = array_count_values(array_column($cards, 'column_id'));
$laneCounts   = array_count_values(array_column($cards, 'swimlane_id'));

// What the board offers its contributions. The metadata of every card was
// loaded with the board in one query, so a badge reads from here rather than
// asking again per card.
$boardSlot = new BoardSlotContext(
    $uiContext,
    $project,
    $scope,
    $labelMap,
    $memberMap,
    $card_metadata ?? [],
    $token,
);

// One estimate read through the project's scale. The sums describe what is on screen, so
// a filtered board reports the filtered total and says so in its existing hint.
$scale        = Estimation::scale($project['estimation_scale']);
$estimating   = Estimation::active($scale);
$estimateUnit = Estimation::unit($scale);
$columnPoints = [];
foreach ($cards as $card) {
    $columnPoints[$card['column_id']] = ($columnPoints[$card['column_id']] ?? 0)
        + (int) $card['estimate_points'];
}

$priorityLabels  = extensions()->priorities()->options();
$prioritySymbols = array_map(
    static fn($priority) => Icon::mark($priority->icon, 'sm'),
    extensions()->priorities()->all(),
);
/*
 * The same for a card: drawing an undeclared priority as one of the known
 * symbols would be a guess, and failing the whole board over a single card would
 * be worse than admitting that one value is not understood. The wrapper's title
 * already carries the stored id, so the mark only has to be neutral -- `info`
 * rather than a question mark because the icon font is subset to what the
 * interface uses, and a glyph that is not in it renders as its own name.
 */
$unknownPriority = Icon::mark('info', 'sm');
$boardHint       = match (true) {
    $project['archived_at'] !== null => t('Archiviertes Projekt · Tickets können gelesen, aber nicht geändert werden'),
    !$canWrite                       => t('Du hast Lesezugriff auf dieses Board'),
    (bool) $filters                  => t('Gefilterte Ansicht · Verschieben über das Kartenmenü'),
    $isLimited                       => t('Begrenzte Ansicht · Verschieben über das Kartenmenü'),
    default                          => '',
};
$emptyCellHint = $filters
    ? t('Keine Treffer mit diesen Filtern')
    : t('Keine Tickets in diesem Bereich');
?>
<?= partial('project/header', [
    'project' => $project,
    'scope'   => $scope,
    'members' => $members,
    'total'   => $total,
    'view'    => 'board',
    'actions' => slot('board.actions', $boardSlot),
]) ?>
<form method="get" class="filterbar" action="<?= s(route('board', ['project' => $projectId])) ?>">
    <label class="search-field">
        <?= Icon::mark('search') ?>
        <input
            name="q"
            aria-label="<?= s(t('Tickets durchsuchen')) ?>"
            placeholder="<?= s(t('Tickets durchsuchen …')) ?>"
            value="<?= s($filters['q'] ?? '') ?>"
        />
    </label>
    <?php
    /*
     * Your own name first and marked as yours. "Was liegt bei mir?" is the
     * question this filter gets asked most, and hunting for your own name in an
     * alphabetical list of colleagues is a poor way to answer it.
     *
     * The value stays the plain user id, so the filter, the query and a shared
     * link are unchanged -- only what the entry is called and where it sits.
     */
    $people = array_column($members, 'name', 'id');
$me         = (int) $scope->userId;
$mine       = [];

// Somebody who administers a board without being a member of it is not in
// this list, and then there is no "me" entry to show.
if (isset($people[$me])) {
    $mine = [$me => t('Ich (:name)', ['name' => $people[$me]])];
    unset($people[$me]);
}
?>
    <?= choice([
        'name'        => 'assignee',
        'label'       => 'Verantwortliche',
        'value'       => $filters['assignee'] ?? '',
        'options'     => ['' => t('Alle Verantwortlichen')] + $mine + $people,
        'id'          => 'filter-assignee',
        'searchLabel' => 'Personen suchen',
    ]) ?>
    <?= choice([
        'name'        => 'label',
        'label'       => 'Label',
        'value'       => $filters['label'] ?? '',
        'options'     => ['' => t('Alle Labels')] + array_column($labels, 'name', 'id'),
        'id'          => 'filter-label',
        'searchLabel' => 'Labels suchen',
    ]) ?>
    <?= choice([
        'name'    => 'priority',
        'label'   => 'Priorität',
        'value'   => $filters['priority'] ?? '',
        'options' => ['' => t('Priorität')] + $priorityLabels,
        'id'      => 'filter-priority',
    ]) ?>
    <?php /* A menu, not a section: its panel lies over the board rather than
             growing inside the bar. Without this the sweep in disclosure.js
             animates the element's own height, which pushes the board down for
             the length of the animation and snaps it back at the end. */ ?>
    <details class="extra-filters" data-menu>
        <summary><?= s(t('Weitere Filter')) ?></summary>
        <div>
            <label>
                <?= s(t('Spalte')) ?>
                <?= choice([
                    'name'        => 'column',
                    'label'       => 'Spalte',
                    'value'       => $filters['column'] ?? '',
                    'options'     => ['' => t('Alle')] + array_column($columns, 'name', 'id'),
                    'id'          => 'filter-column',
                    'searchLabel' => 'Spalten suchen',
                ]) ?>
            </label>
            <label>
                <?= s(t('Swimlane')) ?>
                <?= choice([
                    'name'        => 'swimlane',
                    'label'       => 'Swimlane',
                    'value'       => $filters['swimlane'] ?? '',
                    'options'     => ['' => t('Alle')] + array_column($swimlanes, 'name', 'id'),
                    'id'          => 'filter-swimlane',
                    'searchLabel' => 'Swimlanes suchen',
                ]) ?>
            </label>
            <label>
                <?= s(t('Status')) ?>
                <?= choice([
                    'name'    => 'status',
                    'label'   => 'Status',
                    'value'   => $filters['status'] ?? '',
                    'options' => [
                        ''         => t('Offen und geschlossen'),
                        'open'     => t('Offen'),
                        'closed'   => t('Geschlossen'),
                        'archived' => t('Archiviert'),
                    ],
                    'id' => 'filter-status',
                ]) ?>
            </label>
        </div>
    </details>
    <button class="button subtle"><?= s(t('Filtern')) ?></button>
    <?php if ($filters): ?>
        <a class="clear-filter" href="<?= s(route('board', ['project' => $projectId])) ?>"><?= s(t('Zurücksetzen')) ?></a>
    <?php endif ?>
</form>
<div class="board-meta">
    <span>
        <strong><?= $total ?></strong>
        Tickets · <?= count($swimlanes) ?> Swimlanes
    </span>
    <span><?= s($boardHint) ?></span>
</div>
<div id="board-update" class="update-banner" hidden>
    Es gibt Änderungen im Projekt.
    <button type="button" data-reload>Board aktualisieren <?= Icon::mark('refresh', 'sm') ?></button>
</div>
<?php if ($isLimited): ?>
    <div class="update-banner">
        Die ersten 300 Treffer sind sichtbar. Verfeinere die Filter, um weitere Tickets zu finden.
    </div>
<?php endif ?>
<div
    class="board-scroll"
    id="board"
    data-project="<?= (int) $projectId ?>"
    data-revision="<?= (int) $board['revision'] ?>"
    data-filtered="<?= $filters || $isLimited ? '1' : '0' ?>"
    data-empty-hint="<?= s($emptyCellHint) ?>"
    style="--column-count: <?= count($columns) ?>"
>
    <div class="column-headings">
        <?php foreach ($columns as $column): ?>
            <div class="column-heading" data-column="<?= (int) $column['id'] ?>" <?= $column['closes_tickets'] ? 'data-closes="1"' : '' ?>>
                <span class="status-dot" style="background: <?= s($column['color']) ?>"></span>
                <h2><?= s($column['name']) ?></h2>
                <span class="count"><?= $columnCounts[$column['id']] ?? 0 ?></span>
                <?php if ($column['wip_limit']): ?>
                    <small>/ <?= (int) $column['wip_limit'] ?></small>
                <?php endif ?>
                <?php if ($estimating): ?>
                    <span
                        class="column-points"
                        data-column-points="<?= (int) $column['id'] ?>"
                        title="<?= s(t(Estimation::label($scale)) . ' · ' . $column['name']) ?>"
                    ><span data-points-value><?= (int) ($columnPoints[$column['id']] ?? 0) ?></span><small><?= s($estimateUnit) ?></small></span>
                <?php endif ?>
                <?= slot('board.column.summary', $boardSlot->withColumn($column)) ?>
            </div>
        <?php endforeach ?>
    </div>
    <?php foreach ($swimlanes as $lane): ?>
        <section class="swimlane" data-lane="<?= (int) $lane['id'] ?>">
            <div class="lane-heading">
                <?= Icon::mark('expand_more', 'md', 'mi-turn') ?>
                <h3><?= s($lane['name']) ?></h3>
                <span class="lane-count"><?= $laneCounts[$lane['id']] ?? 0 ?></span>
                <i></i>
            </div>
            <div class="board-grid">
                <?php foreach ($columns as $column): ?>
                    <div
                        class="board-cell"
                        data-column="<?= (int) $column['id'] ?>"
                        data-lane="<?= (int) $lane['id'] ?>"
                        <?= $column['closes_tickets'] ? 'data-closes="1"' : '' ?>
                        aria-label="<?= s($lane['name'] . ' · ' . $column['name']) ?>"
                    >
                        <?php
                    $cell = array_filter(
                        $cards,
                        static fn($ticket) => (int) $ticket['column_id'] === (int) $column['id']
                            && (int) $ticket['swimlane_id'] === (int) $lane['id'],
                    );
                    ?>
                        <?php foreach ($cell as $card): ?>
                            <article
                                class="ticket-card"
                                draggable="<?= $canDrag ? 'true' : 'false' ?>"
                                data-ticket="<?= (int) $card['id'] ?>"
                                data-key="<?= s(Format::ticket($project['ticket_key'], $card['number'])) ?>"
                                data-version="<?= (int) $card['version'] ?>"
                                data-status="<?= s($card['status']) ?>"
                                data-title="<?= s($card['title']) ?>"
                                data-points="<?= (int) $card['estimate_points'] ?>"
                            >
                                <div class="card-top">
                                    <span class="ticket-number"><?= s(Format::ticket($project['ticket_key'], $card['number'])) ?></span>
                                    <?php if (in_array((int) $card['id'], $running_timers, true)): ?>
                                        <span class="timer-pulse" title="<?= s(t('Deine Zeiterfassung läuft')) ?>"></span>
                                    <?php endif ?>
                                    <div>
                                        <span
                                            class="priority priority-<?= s($card['priority']) ?>"
                                            title="<?= s($card['priority']) ?>"
                                        >
                                            <?= $prioritySymbols[$card['priority']] ?? $unknownPriority ?>
                                        </span>
                                        <?php if ($canWrite && !$card['archived_at']): ?>
                                            <button
                                                type="button"
                                                class="card-menu"
                                                data-move-card
                                                aria-label="<?= s(t('Ticket :key verschieben', ['key' => Format::ticket($project['ticket_key'], $card['number'])])) ?>"
                                            >
<?= Icon::mark('more_horiz') ?>                                            </button>
                                        <?php endif ?>
                                        <?= slot('board.card.actions', $boardSlot->withCard($card)) ?>
                                    </div>
                                </div>
                                <a class="card-title" data-ticket-link href="<?= s(route('ticket', ['project' => $projectId, 'ticket' => Format::ticket($project['ticket_key'], $card['number'])])) ?>">
                                    <?= s($card['title']) ?>
                                </a>
                                <p class="card-description"><?= s(mb_strimwidth($card['description'], 0, 95, '…')) ?></p>
                                <div class="card-labels">
                                    <?php foreach ($tags[$card['id']] ?? [] as $labelId): ?>
                                        <?php $label = $labelMap[$labelId]; ?>
                                        <span class="label-tag" style="--tag-color: <?= s($label['color']) ?>">
                                            <?= s($label['name']) ?>
                                        </span>
                                    <?php endforeach ?>
                                    <?= slot('board.card.badges', $boardSlot->withCard($card)) ?>
                                </div>
                                <?= slot('board.card.details', $boardSlot->withCard($card)) ?>
                                <div class="card-bottom">
                                    <span class="due-date"><?= $card['due_date'] ? Icon::mark('schedule', 'sm') . ' ' . s(date('d. M', strtotime($card['due_date']))) : 'Kein Termin' ?></span>
                                    <?php if ($estimating && $card['estimate_points'] !== null): ?>
                                        <span
                                            class="card-points <?= Estimation::offScale($scale, (int) $card['estimate_points']) ? 'off-scale' : '' ?>"
                                            title="<?= s(Estimation::offScale($scale, (int) $card['estimate_points'])
                                                ? t('Wert außerhalb der Skala dieses Projekts')
                                                : t(Estimation::label($scale))) ?>"
                                        >
                                            <?= s(Estimation::display($scale, (int) $card['estimate_points'])) ?><small><?= s($estimateUnit) ?></small>
                                        </span>
                                    <?php endif ?>
                                    <div class="card-assignees">
                                        <?php foreach ($assignments[$card['id']] ?? [] as $userId): ?>
                                            <?php
                                        if (!isset($memberMap[$userId])) {
                                            continue;
                                        }
                                            ?>
                                            <span class="avatar tiny" title="<?= s($memberMap[$userId]['name']) ?>">
                                                <?= s(mb_substr($memberMap[$userId]['name'], 0, 1)) ?>
                                            </span>
                                        <?php endforeach ?>
                                    </div>
                                </div>
                            </article>
                        <?php endforeach ?>
                        <?php if (!$cell): ?>
                            <div class="empty-cell">
                                <span aria-hidden="true">—</span>
                                <small><?= s($emptyCellHint) ?></small>
                            </div>
                        <?php endif ?>
                    </div>
                <?php endforeach ?>
            </div>
        </section>
    <?php endforeach ?>
</div>
<?php if ($canWrite): ?>
    <dialog id="move-card" class="modal">
        <form method="post" data-enhanced>
            <div class="dialog-heading">
                <h2><?= s(t('Ticket verschieben')) ?></h2>
                <button type="button" class="icon-button" data-close-dialog aria-label="Schließen">
                    ×
                </button>
            </div>
            <p class="move-title muted"></p>
            <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
            <input type="hidden" name="version" />
            <input type="hidden" name="board_revision" value="<?= (int) $board['revision'] ?>" />
            <input type="hidden" name="placement" value="append" />
            <label>
                <?= s(t('Spalte')) ?>
                <?= choice([
                    'name'  => 'column_id',
                    'label' => 'Spalte',
                    'value' => '',
                    // The native option keeps data-closes, which app.js still reads
                    // through selectedOptions to decide whether to celebrate.
                    'options'    => array_column($columns, 'name', 'id'),
                    'optionData' => array_map(
                        static fn($closes) => $closes ? ['closes' => '1'] : [],
                        array_column($columns, 'closes_tickets', 'id'),
                    ),
                    'id'          => 'move-column',
                    'searchLabel' => 'Spalten suchen',
                ]) ?>
            </label>
            <label>
                <?= s(t('Swimlane')) ?>
                <?= choice([
                    'name'        => 'swimlane_id',
                    'label'       => 'Swimlane',
                    'value'       => '',
                    'options'     => array_column($swimlanes, 'name', 'id'),
                    'id'          => 'move-swimlane',
                    'searchLabel' => 'Swimlanes suchen',
                ]) ?>
            </label>
            <p class="muted small">Das Ticket wird am Ende des gewählten Bereichs eingeordnet.</p>
            <div class="form-errors" role="alert"></div>
            <button class="button primary">Verschieben →</button>
        </form>
    </dialog>
<?php endif ?>
<?php $this->endblock('content'); ?>
