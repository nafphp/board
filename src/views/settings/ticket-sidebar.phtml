    <?= partial('components/notice', ['severity' => 'info', 'message' => t('Wähle die Ticketattribute für deine Ansicht in diesem Board. Neue Attribute werden automatisch angezeigt. Ticketwerte und die Ansicht anderer bleiben unverändert.')]) ?>
