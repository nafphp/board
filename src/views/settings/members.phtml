<?php

/**
 * Who is in this project, and the form that adds someone.
 *
 * @var array  $members
 * @var array  $availableRoles
 * @var int    $projectId
 * @var string $token
 */

use function Naf\Board\field;
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;

?>
<table class="member-table">
    <thead>
        <tr>
            <th><?= s(t('Person')) ?></th>
            <th><?= s(t('Rolle')) ?></th>
        </tr>
    </thead>
    <tbody>
        <?php foreach ($members as $member): ?>
            <tr>
                <td>
                    <?= s($member['name']) ?>
                    <small><?= s($member['email']) ?></small>
                </td>
                <td><?= s($member['role']) ?></td>
            </tr>
        <?php endforeach ?>
    </tbody>
</table>
<section class="settings-section">
    <h3><?= s(t('Mitglied hinzufügen')) ?></h3>
    <form method="post" data-enhanced action="<?= s(route('project.members', ['project' => $projectId])) ?>">
        <input type="hidden" name="_csrf" value="<?= s($token) ?>" />
        <?= field([
            'label'      => 'E-Mail-Adresse',
            'name'       => 'email',
            'type'       => 'email',
            'required'   => true,
            'attributes' => ['placeholder' => 'person@beispiel.de'],
        ]) ?>
        <?= field([
            'label'   => 'Rolle',
            'name'    => 'role',
            'type'    => 'select',
            'value'   => '',
            'options' => $availableRoles,
            'hint'    => 'Du kannst nur Rechte vergeben, die du selbst besitzt. Eigene Rollen gelten '
                . 'nur für dieses Projekt.',
            'choice' => ['searchLabel' => 'Rollen suchen'],
        ]) ?>
        <p class="settings-hint"><?= s(t('Die Person braucht bereits ein Konto.')) ?></p>
        <div class="form-errors" role="alert"></div>
        <div class="settings-actions">
            <button class="button primary"><?= s(t('Mitgliedschaft speichern')) ?></button>
        </div>
    </form>
</section>
