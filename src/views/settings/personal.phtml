<?php

/**
 * What one person chooses for themselves, in every project.
 *
 * @var array  $preferences
 * @var object $user
 */

use Naf\Board\Domain\Placement;
use Naf\Board\Support\Locales;

use function Naf\Board\field;
use function Naf\config;
use function Naf\Form\csrf;
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;

$zones = ['Europe/Berlin', 'Europe/London', 'America/New_York', 'UTC'];
// The same list the top bar offers, so a package that brings a language makes it
// selectable in both places at once.
$languages = Locales::available();
$flags     = [];
foreach ($languages as $code => $name) {
    $flags[$code] = ['mark' => Locales::flag($code)];
}
$logins = (array) config('auth:logins', []);
?>
<form method="post" data-enhanced action="<?= s(route('preferences.save')) ?>">
    <input type="hidden" name="_csrf" value="<?= s(csrf()->token()) ?>" />
    <?= field([
        'label'   => 'Farbwelt',
        'name'    => 'palette',
        'type'    => 'select',
        'value'   => $preferences['palette'] ?? 'classic',
        'options' => ['classic' => t('Klassisch'), 'anthracite' => t('Anthrazit')],
    ]) ?>
    <?= field([
        'label'   => 'Helligkeit',
        'name'    => 'theme',
        'type'    => 'select',
        'value'   => $preferences['theme'],
        'options' => ['system' => t('Wie mein Gerät'), 'light' => t('Hell'), 'dark' => t('Dunkel')],
    ]) ?>
    <?= field([
        'label'   => 'Sprache',
        'name'    => 'locale',
        'type'    => 'select',
        'value'   => $preferences['locale'],
        'options' => $languages,
        'choice'  => ['optionData' => $flags, 'searchLabel' => 'Sprachen suchen'],
    ]) ?>
    <?= field([
        'label'   => 'Zeitzone',
        'name'    => 'timezone',
        'type'    => 'select',
        'value'   => $preferences['timezone'],
        'options' => array_combine($zones, $zones),
        'choice'  => ['searchLabel' => 'Zeitzonen suchen'],
    ]) ?>
    <div class="checkbox-list">
        <?= field([
            'label' => 'Benachrichtigungen in Nafinity',
            'name'  => 'notify_in_app',
            'type'  => 'checkbox',
            'value' => (int) $preferences['notify_in_app'],
        ]) ?>
        <?= field([
            'label' => 'Zusätzlich per E-Mail, wenn für den Workspace aktiviert',
            'name'  => 'notify_mail',
            'type'  => 'checkbox',
            'value' => (int) $preferences['notify_mail'],
        ]) ?>
    </div>
    <?php // A board that rearranges itself while you are reading it is not what
          // everybody wants from a board. Off, the page still works -- it simply
          // shows what it showed when it was loaded, like any other page.
          //
          // The second switch cuts both ways on purpose, and says so: it takes
          // the presence channel out of this person's token, so they send
          // nothing and therefore also see nobody. Being invisible while
          // watching the others is not a setting worth offering.?>
    <div class="checkbox-list">
        <?= field([
            'label' => 'Änderungen anderer sofort auf dem Board zeigen',
            'name'  => 'live_updates',
            'type'  => 'checkbox',
            'value' => (int) ($preferences['live_updates'] ?? 1),
        ]) ?>
        <?= field([
            'label' => 'Anzeigen, wer gerade im Projekt ist',
            'name'  => 'presence',
            'type'  => 'checkbox',
            'value' => (int) ($preferences['presence'] ?? 1),
            'hint'  => 'Die anderen sehen, auf welcher Seite du gerade bist und welches Ticket du geöffnet hast. Aus siehst du sie ebenfalls nicht mehr.',
        ]) ?>
    </div>
    <?= field([
        'label'   => 'Neue Tickets',
        'name'    => 'new_tickets',
        'type'    => 'select',
        'value'   => Placement::person($preferences['new_tickets'] ?? null),
        'options' => array_map(t(...), Placement::forPerson()),
        'hint'    => 'Gilt für die Tickets, die du anlegst. Unten anhängen kann in einer langen Spalte heißen, dass du dein eigenes Ticket erst suchen musst.',
    ]) ?>
    <div class="form-errors" role="alert"></div>
    <div class="settings-actions">
        <button class="button primary"><?= s(t('Einstellungen speichern')) ?></button>
    </div>
</form>
<?php if ($logins): ?>
    <section class="settings-section">
        <h3><?= s(t('Externe Konten')) ?></h3>
        <p class="settings-hint">
            <?= s(t('Verknüpfe dein angemeldetes Konto ausdrücklich mit deinem Firmenkonto.')) ?>
        </p>
        <div class="settings-actions">
            <?php foreach ($logins as $key => $login): ?>
                <a class="button subtle" href="<?= s(route('oauth.connect', ['provider' => $key])) ?>">
                    <?= s(t(':provider verknüpfen', ['provider' => $login['label'] ?? $key])) ?>
                </a>
            <?php endforeach ?>
        </div>
    </section>
<?php endif ?>
