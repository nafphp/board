<?php

/**
 * The accounts of this installation, each with what they hold and where.
 *
 * Opening one is the edit, like everywhere else in these settings. The editor
 * itself comes from naf/rbac -- this card only says who there is to edit.
 *
 * @var array $people
 */

use Naf\Board\Rbac\Installation;
use Naf\Board\Support\Icon;

use function Naf\Auth\auth;
use function Naf\Board\partial;
use function Naf\Form\csrf;
use function Naf\I18n\t;
use function Naf\Rbac\rbac;
use function Naf\View\s;

?>
<div class="settings-rows" data-kind="user">
    <?php if (rbac()->allows((int) (auth()->user()?->getIdentifier() ?? 0), Installation::MANAGE_USERS)): ?>
        <details class="settings-row">
            <summary class="settings-row-head">
                <span class="settings-row-title"><?= s(t('Person einladen')) ?></span>
                <?= Icon::mark('person_add', 'sm', 'settings-row-caret') ?>
            </summary>
            <div class="settings-row-body">
                <p class="settings-hint"><?= s(t('Wähle das erste Board. Die Person legt ihr Konto selbst an und erhält nur dort Zugang. Weitere Boards kannst du später über die Kontosuche zuweisen.')) ?></p>
                <?php if ($inviteTargets): ?>
                    <?= partial('settings/invite-form', ['projectId' => null, 'token' => csrf()->token(), 'inviteTargets' => $inviteTargets, 'inviteRoles' => ['member' => 'Member', 'viewer' => 'Viewer']]) ?>
                <?php else: ?>
                    <p class="settings-hint"><?= s(t('Du kannst derzeit für kein aktives Board Mitglieder verwalten.')) ?></p>
                <?php endif ?>
            </div>
        </details>
    <?php endif ?>
    <p class="settings-hint">
        <?= s(t(
            'Eine Rolle ohne Ort gilt überall, eine mit Ort nur dort. Deine eigenen Rollen kann '
            . 'nur jemand anderes ändern.',
        )) ?>
    </p>
    <?php foreach ($people as $person): ?>
        <details class="settings-row">
            <summary class="settings-row-head">
                <span class="settings-user-info">
                    <span class="settings-row-title"><?= s($person['name']) ?></span>
                    <span class="settings-user-roles">
                        <?php if (!$person['active']): ?>
                            <span class="settings-user-state"><?= s(t('inaktiv')) ?></span>
                        <?php endif ?>
                        <?php if ($person['roles'] === []): ?>
                            <span class="settings-user-state"><?= s(t('keine Rolle')) ?></span>
                        <?php endif ?>
                        <?php foreach ($person['roles'] as $grant): ?>
                            <span class="settings-user-role <?= $grant['scope'] === '' ? 'is-global' : '' ?>">
                                <span class="settings-user-place"><?= s($grant['scopeLabel']) ?></span>
                                <span class="settings-user-role-name"><?= s(t($grant['label'])) ?></span>
                            </span>
                        <?php endforeach ?>
                    </span>
                </span>
                <?= Icon::mark('expand_more', 'sm', 'mi-turn settings-row-caret') ?>
            </summary>
            <div class="settings-row-body">
                <p class="settings-hint settings-user-email"><?= s($person['email']) ?></p>
                <?= partial('rbac/grants', [
                    'user'   => $person['id'],
                    'name'   => $person['name'],
                    'return' => '/settings',
                ]) ?>
            </div>
        </details>
    <?php endforeach ?>
</div>
