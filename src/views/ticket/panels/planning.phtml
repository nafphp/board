<?php

use Naf\Board\Domain\Estimation;
use Naf\Board\Support\Duration;
use Naf\Board\Support\Format;
use Naf\Board\Support\Icon;

use function Naf\Board\partial;
use function Naf\I18n\t;
use function Naf\route;
use function Naf\View\s;

/**
 * The planning group: estimate, dates and the time actually counted.
 *
 * Contributed fields of this group are rendered after the ones Nafinity brings,
 * in the order the registry gives them.
 */
?>
<?php if (!$slot->showsGroup('planning', $estimating ? [] : ['estimate_points'])) {
    return;
} ?>
<section class="ticket-sidebar-group">
    <h2><?= s(t('Planung & Zeit')) ?></h2>
    <dl class="ticket-meta">
        <?php if ($estimating && $slot->shows('estimate_points')): ?><dt><?= s(t(Estimation::label($scale))) ?></dt><dd><?= $slot->field->render('estimate_points', Estimation::label($scale), 'select', $points, $pointDisplay, $pointOptions) ?></dd><?php endif ?>
        <?php if ($slot->shows('start_date')): ?>
        <dt><?= s(t('Startdatum')) ?></dt><dd><?= $slot->field->render('start_date', 'Startdatum', 'date', $slot->ticket['start_date'], $slot->ticket['start_date'] ? s(date('d.m.Y', strtotime($slot->ticket['start_date']))) : $empty) ?></dd>
        <?php endif ?>
        <?php if ($slot->shows('due_date')): ?>
        <dt><?= s(t('Fällig am')) ?></dt><dd><?= $slot->field->render('due_date', 'Fällig am', 'date', $slot->ticket['due_date'], $slot->ticket['due_date'] ? s(date('d.m.Y', strtotime($slot->ticket['due_date']))) : $empty) ?></dd>
        <?php endif ?>
        <?php if ($slot->shows('estimate_minutes')): ?>
        <dt><?= s(t('Geschätzt')) ?></dt><dd><?= $slot->field->render('estimate_minutes', 'Geschätzt', 'duration', $slot->ticket['estimate_minutes'] === null ? '' : Duration::format((int) $slot->ticket['estimate_minutes']), s($duration($slot->ticket['estimate_minutes'] === null ? null : (int) $slot->ticket['estimate_minutes']))) ?></dd>
        <?php endif ?>
        <?php if ($slot->shows('spent_minutes')): ?>
        <dt><?= s(t('Erfasst')) ?></dt>
        <dd class="ticket-spent">
            <?= $slot->field->render('spent_minutes', 'Erfasst', 'duration', Duration::format((int) $slot->ticket['spent_minutes']), s($duration((int) $slot->ticket['spent_minutes']))) ?>
            <?php if (!$slot->isNew && $slot->editable):
                $timerState     = $slot->timer['state'] ?? 'stopped';
                $timerSeconds   = (int) ($slot->timer['seconds'] ?? 0);
                $timerElsewhere = $slot->timer['elsewhere'] ?? null;
                $timerReference = Format::ticket((string) $slot->project['ticket_key'], (int) $slot->ticket['number']);
                $timerClock     = static fn(int $seconds): string => $seconds >= 3600
                    ? sprintf('%d:%02d:%02d', intdiv($seconds, 3600), intdiv($seconds % 3600, 60), $seconds % 60)
                    : sprintf('%d:%02d', intdiv($seconds, 60), $seconds % 60);
                $timerTitleId = 'timer-title-' . (int) $slot->ticket['id'];
                ?>
                <?php /*
                 * The row shows a compact stopwatch: just its symbol while nothing is counted,
                 * the clock as soon as there is time on it. Everything else -- starting,
                 * pausing and booking -- happens in the dialog it opens, which names the
                 * ticket it counts on and the one it would pause.
                 */ ?>
                <div
                    class="ticket-timer"
                    data-ticket-timer
                    data-action="<?= s(route('ticket.timer', $slot->params)) ?>"
                    data-token="<?= s($slot->token) ?>"
                    data-state="<?= s($timerState) ?>"
                    data-seconds="<?= $timerSeconds ?>"
                    data-carry="<?= (int) ($slot->timer['carry'] ?? 0) ?>"
                    data-reference="<?= s($timerReference) ?>"
                >
                    <button
                        type="button"
                        class="timer-trigger"
                        data-timer-open
                        aria-haspopup="dialog"
                        aria-controls="<?= s($timerTitleId) ?>-dialog"
                        aria-label="<?= s(t('Zeiterfassung öffnen')) ?>"
                        title="<?= s(t('Zeiterfassung')) ?>"
                    >
                        <svg class="timer-glyph" viewBox="0 0 16 16" aria-hidden="true">
                            <circle cx="8" cy="9.2" r="5.6" />
                            <path d="M8 9.2V6.4M6.4 1.6h3.2M12.3 4.6l1-1" />
                        </svg>
                        <time class="timer-readout" data-timer-readout><?= s($timerClock($timerSeconds)) ?></time>
                    </button>
                    <dialog id="<?= s($timerTitleId) ?>-dialog" class="modal timer-dialog" aria-labelledby="<?= s($timerTitleId) ?>" data-timer-dialog>
                        <header class="timer-dialog-heading">
                            <div>
                                <h2 id="<?= s($timerTitleId) ?>"><?= s(t('Zeiterfassung')) ?></h2>
                                <p class="timer-dialog-ticket"><span class="ticket-key"><?= s($timerReference) ?></span> <span><?= s($slot->ticket['title']) ?></span></p>
                            </div>
                            <button type="button" class="icon-button" data-timer-close aria-label="<?= s(t('Zeiterfassung schließen')) ?>"><?= Icon::mark('close') ?></button>
                        </header>
                        <div class="timer-dialog-clock">
                            <time class="timer-dialog-time" data-timer-readout><?= s($timerClock($timerSeconds)) ?></time>
                            <span class="timer-dialog-state" data-timer-status></span>
                        </div>
                        <p class="timer-elsewhere" data-timer-elsewhere <?= $timerElsewhere ? '' : 'hidden' ?>>
                            <?= Icon::mark('info', 'sm') ?>
                            <span data-timer-elsewhere-text><?= $timerElsewhere ? s(t('Deine Zeiterfassung läuft gerade auf :ticket. Starten pausiert sie dort, die Zeit bleibt erhalten.', ['ticket' => $timerElsewhere['reference']])) : '' ?></span>
                        </p>
                        <div class="timer-dialog-actions">
                            <button type="button" class="button subtle timer-run" data-timer-action="start">
                                <svg viewBox="0 0 14 14" aria-hidden="true"><path class="glyph-play" d="M4.6 2.7 11.2 7 4.6 11.3Z" /><path class="glyph-pause" d="M4.9 3.2v7.6M9.1 3.2v7.6" /></svg>
                                <span data-timer-run-label><?= s(t('Starten')) ?></span>
                            </button>
                            <button type="button" class="button primary timer-book" data-timer-action="stop">
                                <?= Icon::mark('check', 'sm') ?>
                                <span data-timer-book-label><?= s(t('Buchen')) ?></span>
                            </button>
                        </div>
                        <p class="timer-dialog-note muted" data-timer-note></p>
                        <div class="form-errors" role="alert"></div>
                    </dialog>
                </div>
            <?php endif ?>
        </dd>
        <?php endif ?>
    <?php foreach ($slot->fieldsIn('planning') as $metaKey => $metaField): ?>
        <?= partial('ticket/metadata', [
            'definition' => $metaField,
            'value'      => $slot->value($metaKey),
            'field'      => $slot->field,
            'editable'   => $slot->editable,
        ]) ?>
    <?php endforeach ?>
    </dl>
    <div data-ticket-readonly="progress" class="ticket-time-progress">
        <?php if ($slot->shows('estimate_minutes') && $slot->shows('spent_minutes') && (int) $slot->ticket['estimate_minutes'] > 0): ?><progress value="<?= min((int) $slot->ticket['spent_minutes'], (int) $slot->ticket['estimate_minutes']) ?>" max="<?= (int) $slot->ticket['estimate_minutes'] ?>" aria-label="<?= s(t('Erfasster Zeitaufwand')) ?>"></progress><span class="muted small"><?= s($duration(abs((int) $slot->ticket['estimate_minutes'] - (int) $slot->ticket['spent_minutes']))) ?> <?= s(t((int) $slot->ticket['spent_minutes'] > (int) $slot->ticket['estimate_minutes'] ? 'über Schätzung' : 'verbleibend')) ?></span><?php endif ?>
    </div>
</section>
