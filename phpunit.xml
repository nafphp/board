<?xml version="1.0" encoding="UTF-8"?>
<!--
    `composer test` runs all of it. Unit needs nothing but the classes under
    test; everything else boots the board with tests/Fixtures as its host and
    reaches the MariaDB that tests/bootstrap.php starts when none is running.
    The variables below are defaults: anything already set in the environment
    wins, which is how a CI service or another server is chosen.
-->
<phpunit
    bootstrap="tests/bootstrap.php"
    colors="true"
    failOnRisky="true"
    failOnWarning="true"
    failOnDeprecation="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    displayDetailsOnPhpunitDeprecations="true"
    cacheResult="false"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Database">
            <directory>tests/Database</directory>
        </testsuite>
        <testsuite name="Worker">
            <directory>tests/Worker</directory>
        </testsuite>
        <testsuite name="Http">
            <directory>tests/Http</directory>
        </testsuite>
    </testsuites>
    <php>
        <ini name="error_reporting" value="-1" />
        <ini name="display_errors" value="1" />
        <const name="PHPUNIT_RUNNING" value="true" />
        <env name="APP_ENV" value="test" force="true" />
        <env name="APP_URL" value="http://127.0.0.1:38080" />
        <env name="DB_HOST" value="127.0.0.1" />
        <env name="DB_PORT" value="33306" />
        <env name="DB_DATABASE" value="nafinity_test" />
        <env name="DB_USERNAME" value="board" />
        <env name="DB_PASSWORD" value="board" />
    </php>
</phpunit>
