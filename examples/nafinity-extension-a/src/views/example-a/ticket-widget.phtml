<?php

use App\Support\Icon;

use function Naf\I18n\t;
use function Naf\View\s;

/**
 * This extension's own widget, between the links and the attachments.
 *
 * It reads its values straight from the slot's context rather than from a data
 * provider, because they are already there. The values themselves are edited
 * through the registered ticket fields in the sidebar, which go through
 * Nafinity's auto-save and its version check.
 *
 * @var \Nafinity\Support\TicketSlotContext    $slot
 * @var \Nafinity\Definition\UiContribution    $contribution
 */
$reviewed   = $slot->value('example.reviewed') === true;
$externalId = $slot->value('example.external_id');
?>
<section
    class="detail-section"
    data-ticket-section="example-review"
    data-extension-id="<?= s($contribution->id) ?>"
    <?= $contribution->module === null ? '' : 'data-extension-module="' . s($contribution->module) . '"' ?>
>
    <h2><?= Icon::mark('check_circle', 'sm') ?> <?= s(t('Prüfung')) ?></h2>
    <p>
        <?= $reviewed
            ? s(t('Dieses Ticket ist geprüft.'))
            : s(t('Dieses Ticket ist noch nicht geprüft.')) ?>
    </p>
    <?php if ($lastRun ?? null): ?>
        <p class="muted small">
            <?= s(t('Zuletzt gezählt: :when', ['when' => $lastRun])) ?>
        </p>
    <?php endif ?>
    <?php if ($externalId): ?>
        <p class="muted small">
            <?= s(t('Externe Nummer: :id', ['id' => $externalId])) ?>
        </p>
    <?php endif ?>
</section>
