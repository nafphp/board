<?php

use function Naf\I18n\t;
use function Naf\View\s;

/**
 * The board badge for a reviewed ticket.
 *
 * Everything this needs is in the slot's own context: the board loaded every
 * card's metadata in one query, so `value()` reads what is already here instead
 * of asking again per card.
 *
 * @var \Nafinity\Support\BoardSlotContext $slot
 */
if ($slot->value('example.reviewed') !== true) {
    return;
}
?>
<span class="card-badge example-reviewed" title="<?= s(t('Geprüft')) ?>">✓</span>
